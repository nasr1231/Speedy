@page
@model LoginModel

@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = "_Layout";
}
<form class="form w-100 fv-plugins-bootstrap5 fv-plugins-framework" id="kt_sign_in_form" novalidate="novalidate" method="post">
    <!--begin::Input group-->
    <div class="fv-row mb-7 fv-plugins-icon-container">
        <!--begin::Label-->
        <label class="form-label fs-6 fw-bold text-dark">Email</label>
        <!--end::Label-->
        <!--begin::Email-->
        <input type="text" placeholder="البريد الإلكتروني أو رقم الهوية" asp-for="Input.Email" autocomplete="off" class="form-control" />
        <span asp-validation-for="Input.Email" class="text-danger mt-3"></span>
        <!--end::Email-->
    </div>
    <!--end::Input group-->
    <!--begin::Input group-->
    <div class="fv-row mb-10 fv-plugins-icon-container">
        <!--begin::Wrapper-->
        <!--begin::Label-->
        <label class="form-label fw-bold text-dark fs-6">Password</label>
        <!--end::Label-->
        <!--begin::Password-->
        <input type="password" placeholder="Password" asp-for="Input.Password" autocomplete="off" class="form-control" />
        <span asp-validation-for="Input.Password" class="text-danger mt-3"></span>
        <!--end::Password-->
    </div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <!--end::Input group-->
    <!--begin::Actions-->
    <div class="text-center">
        <!--begin::Submit button-->
        <button type="submit" id="kt_sign_in_submit" class="btn btn-primary">
            <!--begin::Indicator label-->
            <span class="indicator-label">تسجيل الدخول</span>
            <!--end::Indicator label-->
            <!--begin::Indicator progress-->
            <span class="indicator-progress">
                برجاء الإنتظار...
                <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
            </span>
            <!--end::Indicator progress-->
        </button>
        <!--end::Submit button-->
    </div>
    <!--end::Actions-->
</form>
