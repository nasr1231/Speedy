@model UserFormViewModel
@{
    ViewData["Title"] = $"{(Model?.Id > 0 ? "Edit" : "Add")} User";
}

<form asp-action="@(Model?.Id > 0 ? "Edit" : "Create")"
      data-ajax-method="post"
      data-ajax="true"
      data-ajax-begin="OnModalBegin"
      data-ajax-success="OnModalSuccess"
      data-ajax-failure="ShowErrorMessage"
      data-ajax-complete="OnModalComplete">

    @if (Model?.Id > 0)
    {
        <input type="hidden" asp-for="Id" />
    }
    <div class="d-flex flex-column mb-8 fv-row fv-plugins-icon-container">
    </div>

    <div class="row mb-5">
        <div class="w-100 w-md-50">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required"></span>Full Name</label>
            <input type="text" asp-for="FullName" class="form-control form-control-solid" placeholder="Enter FullName">
            <span asp-validation-for="@Model!.FullName" class="text-danger d-block h-10px"></span>
        </div>
        <div class="w-100 w-md-50">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required">UserName</span></label>
            <input type="text" asp-for="UserName" class="form-control form-control-solid" placeholder="Enter UserName">
            <span asp-validation-for="@Model!.UserName" class="text-danger d-block h-10px"></span>
        </div>
        <div class="w-100">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required">Email</span></label>
            <input type="text" asp-for="Email" class="form-control form-control-solid" placeholder="Enter Email">
            <span asp-validation-for="@Model!.Email" class="text-danger d-block h-10px"></span>
        </div>
    </div>
    <div class="row mb-5">
        <div class="w-100 w-md-50">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required">Password</span></label>
            <input type="password" asp-for="Password" class="form-control form-control-solid" placeholder="Enter Password">
            <span asp-validation-for="@Model!.Password" class="text-danger d-block h-10px"></span>
        </div>
        <div class="w-100 w-md-50">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required">ConfirmPassword</span></label>
            <input type="password" asp-for="ConfirmPassword" class="form-control form-control-solid" placeholder="Confirm Password">
            <span asp-validation-for="@Model!.ConfirmPassword" class="text-danger d-block h-10px"></span>
        </div>
    </div>    

    <div class="w-100 w-md-50 mb-5">
        <label asp-for="Roles" class="required form-label "></label>
        <select class="form-select form-select-solid js-select2" data-placeholder="Choose the Specialty" asp-for="SelectedRoles" asp-items="@Model.Roles">
            <option></option>
        </select>
        <span asp-validation-for="SelectedRoles" class="text-danger d-block"></span>
    </div>

    <partial name="_ModalFooter" />
</form>
