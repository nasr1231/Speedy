@model DeliveryFormViewModel

<form asp-action="Create"
      data-ajax-method="post"
      data-ajax="true"
      data-ajax-begin="OnModalBegin"
      data-ajax-success="OnModalSuccess"
      data-ajax-failure="ShowErrorMessage"
      data-ajax-complete="OnModalComplete">    
    <div class="d-flex flex-column mb-8 fv-row fv-plugins-icon-container">
    </div>

    <div class="row mb-5">
        <div class="w-100 w-md-50">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required"></span>رقم الهاتف</label>
            <input type="text" asp-for="@Model.MobileNumber" class="form-control form-control-solid" placeholder="أدخل رقم الهاتف">
            <span asp-validation-for="@Model!.MobileNumber" class="text-danger d-block h-10px"></span>
        </div>
        <div class="col-12 d-flex align-items-center pt-3 pb-5">
            <input class="form-check-input" type="checkbox" asp-for="@Model.HasWhatsApp" id="flexCheck" />
            <label class="form-check-label" for="flexCheckDefault">
                هل يوجد واتساب على هذا 
            </label>
        </div>       
    </div>
    <div class="row mb-5">
        @* <div class="w-100 w-md-50">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required">Password</span></label>
            <input type="password" asp-for="Password" class="form-control form-control-solid" placeholder="Enter Password">
            <span asp-validation-for="@Model!.Password" class="text-danger d-block h-10px"></span>
        </div> *@
       @*  <div class="w-100 w-md-50">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required">ConfirmPassword</span></label>
            <input type="password" asp-for="ConfirmPassword" class="form-control form-control-solid" placeholder="Confirm Password">
            <span asp-validation-for="@Model!.ConfirmPassword" class="text-danger d-block h-10px"></span>
        </div> *@
    </div>

    @* <div class="w-100">
        <div class="d-flex flex-column mb-8" id="container">
            <label asp-for="Roles"></label>
            <select class="form-select js-select2" data-control="select2" data-placeholder="Select Role" data-hide-search="true" asp-for="@Model!.SelectedRoles" asp-items="@Model!.Roles">
                <option></option>
            </select>
            <span asp-validation-for="@Model.SelectedRoles" class="text-danger d-block"></span>
        </div>
    </div> *@

    <partial name="_ModalFooter" />
</form>
