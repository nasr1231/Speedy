@model UserViewModel

<tr>
    <td>@Model.Id</td>      
    <td>@Model.UserName</td>      
    <td>@User.FindFirst(ClaimTypes.Role)!.Value</td>
    <td>@Model.Email</td>      
    <td>@Model.CreatedOn</td>      
    <td>@Model.LastUpdatedOn</td>      
    <td>
        <span class="badge badge-light-@(Model.IsActive ? "success" : "danger")">
            @(Model.IsActive ? "Available" : "Not Active")
        </span>
    </td>
    <td>       
        <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-bold fs-7 w-150px h-100px py-4" data-kt-menu="true">
            <div class="menu-item px-1 py-1">
                <a href="javascript:;" class="js-render-modal p-0 py-2 ps-5 fs-6 text-dark w-100 text-start btn btn-active-light-secondary"
                   data-url="/Users/Edit/@Model.Id" data-title="Edit User" data-is-edited="true">
                    Edit
                </a>
            </div>
            <div class="menu-item px-1 py-1">
                <a href="javascript:;" class="js-render-modal p-0 py-2 ps-5 fs-6 text-dark w-100 text-start btn btn-active-light-secondary"
                   data-title="Reset Password" data-url="/Users/ResetPassword/@Model.Id" data-update="true">
                    Reset Password
                </a>
            </div>
            <div class="menu-item px-1 py-1">
                <a href="javascript:;" class="px-3 js-toggle-status p-0 py-2 ps-5 fs-6 text-danger w-100 text-start btn btn-active-light-secondary"
                   data-id="@Model.Id" data-url="/Users/ToggleStatus/@Model.Id" data-title="Edit User">
                    Change Status
                </a>
            </div>
        </div>
    </td>
</tr>   