@model UserViewModel

<td>@Model.Id</td>
<td>@Model.UserName</td>
<td>
    @Model.Role
</td>
<td>@Model.Email</td>
<td>@Model.CreatedOn</td>
<td>@Model.LastUpdatedOn</td>
<td>
    <span class="badge badge-light-@(Model.IsActive ? "success" : "danger")">
        @(Model.IsActive ? "Available" : "Not Active")
    </span>
</td>
<td class="text-center">
    <a href="#" class="btn btn-sm btn-light btn-flex btn-center btn-active-light-primary" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
        Actions
        <i class="fa-solid fa-arrow-down fs-7 ms-1"></i>
    </a>
    <!--begin::Menu-->
    <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-150px py-4" data-kt-menu="true" style="" bis_skin_checked="1">
        <!--begin::Menu item-->
        <div class="menu-item px-3" bis_skin_checked="1">
            <a href="javascript:;" class="js-render-modal menu-link px-3"
               data-url="/Users/Edit/@Model.Id" data-title="Edit User" data-is-edited="true">
                Edit
            </a>
        </div>
        <!--end::Menu item-->
        <!--begin::Menu item-->
        <div class="menu-item px-3" bis_skin_checked="1">
            <a href="javascript:;" class="js-render-modal menu-link px-3 text-left"
               data-title="Reset Password" data-url="/Users/ResetPassword/@Model.Id" data-update="true">
                Reset Password
            </a>
        </div>
        <!--end::Menu item-->
        <!--begin::Menu item-->
        <div class="menu-item px-3" bis_skin_checked="1">
            <div class="menu-item px-1 py-1">
                <a href="javascript:;" class="px-3 js-toggle-status menu-link"
                   data-id="@Model.Id" data-url="/Users/ToggleStatus/@Model.Id" data-title="Edit User">
                    Change Status
                </a>
            </div>
        </div>
        <!--end::Menu item-->
    </div>
    <!--end::Menu-->
</td>  