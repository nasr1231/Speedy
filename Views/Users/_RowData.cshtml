@model UserViewModel

<tr>
    <td>@Model.Id</td>      
    <td>@Model.UserName</td>      
    <td>@Model.SelectedRoles</td>      
    <td>@Model.Email</td>      
    <td>@Model.CreatedOn</td>      
    <td>@Model.LastUpdatedOn</td>      
    <td>
        <span class="badge badge-light-@(Model.IsActive ? "success" : "danger")">
            @(Model.IsActive ? "Available" : "Not Active")
        </span>
    </td>
    <td>
        <div class="btn-group">
            <!--begin::Menu item-->
            <a class="js-render-modal btn btn-sm btn-primary" data-url="/Users/Edit/@Model.Id" data-title="Edit User" data-is-edited="true">
                <i class="bi bi-pencil-square"></i>
                Edit
            </a>
            <!--end::Menu item-->
            <!--begin::Menu item-->
            <a class="js-render-modal btn btn-sm btn-info">
                <i class="bi bi-pencil-square"></i>
                Toggle Status
            </a>      
            <!--end::Menu item-->
            <!--begin::Menu item-->
            <div class="menu-item px-3">
                <a href="javascript:;" class="menu-link flex-stack px-3 js-render-modal"
                   data-title="Reset Password" data-url="/Users/ResetPassword/@Model.Id"
                   data-update="true">
                    Reset Password
                </a>
            </div>
            <!--end::Menu item-->
        </div>
    </td>
</tr>   