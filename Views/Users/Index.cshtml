@model IEnumerable<UserViewModel>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery antiforgery
@{
    ViewData["Title"] = "System Users";
    Layout = "_Layout";
}

@section Styles {

    <link href="~/assets/Panel/plugins/datatables/datatables.bundle.css" rel="stylesheet" crossorigin="anonymous" />
}

<div class="card shadow-sm mb-5 mb-lg-10">
    <div class="card-header">
        <div class="card-title">
            <div class="symbol symbol-70px me-4">
                <div class="symbol-label fs-2 fw-semibold text-success">
                    <i class="fa-solid fa-truck-fast text-primary"></i>
                </div>
                <span class="symbol-badge badge badge-circle bg-primary start-100 text-white">@Model.Where(u => u.Role == AppRoles.Clerk || u.Role == AppRoles.Admin).Count()</span>
            </div>
            <h2 class="fw-bolder">Users</h2>
        </div>
        <div class="card-toolbar">
            <a href="javascript:;" class="btn btn-sm btn-light btn-primary fs-4 fw-bolder js-render-modal" data-title="Add User" data-url="/Users/Create">
                <i class="bi bi-plus-square-dotted"></i>
                Add User
            </a>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-5 mb-lg-10 min-h-md-425px">
    <div class="card-body pt-0">
        <div class="table-responsive" style="min-height: 270px">
            <partial name="_TableHeader" />
            <table class="table table-row-bordered table-row-gray-300 gy-3 align-middle js-datatable" data-export-title="Delivery Agents">
                <thead>
                    <tr class="fw-bold fs-6 text-gray-800">
                        <th style="width:155px;">Id</th>
                        <th>UserName</th>
                        <th>Role</th>
                        <th>Email</th>                        
                        <th>Create Date</th>
                        <th>Updated On</th>
                        <th>Status</th>
                        <th class="js-no-export text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>                    
                    @foreach (var user in Model.Where(u => u.Role == AppRoles.Clerk || u.Role == AppRoles.Admin))
                    {
                        <tr>
                            <partial name="_RowData" model="@user" />
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<input type="hidden" name="__RequestVerificationToken" value="@antiforgery.GetAndStoreTokens(Context).RequestToken" />

@section Plugins {
    <script src="~/assets/Panel/plugins/datatables/datatables.bundle.js"></script>
    <script src="~/assets/Panel/plugins/datatables/vfs_fonts.js"></script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

}