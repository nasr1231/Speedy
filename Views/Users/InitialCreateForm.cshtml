<style>
    #users-parent {
        -webkit-box-shadow: 0px 0px 60px 4px rgba(0,0,0,0.10);
        -moz-box-shadow: 0px 0px 60px 4px rgba(0,0,0,0.10);
        box-shadow: 0px 0px 60px 4px rgba(0,0,0,0.10);
    }    
    

.roles {
    margin: auto;
}

.box {
    background-color: #fff;
    border-radius: 16px;                
    z-index: 1;        
    min-height: 252px;
    min-width: 183px;
    -webkit-box-shadow: 0px 3px 99px 14px rgba(0,0,0,0.1);
    -moz-box-shadow: 0px 3px 99px 14px rgba(0,0,0,0.1);
    box-shadow: 0px 3px 99px 14px rgba(0,0,0,0.1);
}

.box:hover {
    transition: 0.5s;
}

.box:hover::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -5px;
    border-radius: 16px;
    background: linear-gradient(220.94deg, #3D80FF 30%, #903BF5 70%);
    transition: .5s;
}

.box:hover::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -5px;
    border-radius: 13px;
    background-color: white;
    left: -3px;
    top: -3px;
    bottom: -3px;
    right: -3px;
}

</style>


<!--begin::Main-->
<div class="d-flex flex-column flex-root">
    <!--begin::Authentication - Sign-up -->
    <div class="d-flex justify-content-center flex-column-fluid bgi-position-y-bottom position-x-center bgi-no-repeat bgi-size-contain bgi-attachment-fixed align-items-center" style="background-image: url(/assets/Website/LoginAssets/14.png)">
        <div id="users-parent" class="d-flex flex-center flex-column p-20 bg-white rounded-4" style="font-weight: 500;">
            <div class="row w-100">
                <p class="text-center p-2 pb-15 fs-1">اختر نوع حسابك</p>
            </div>
            <!-- start row -->
            <div class="row">
                <div class="roles d-flex justify-content-center flex-md-row align-items-center flex-wrap gap-md-20 m-0">
                    <!-- card-1 -->
                    <div class="col-lg-3 col-md-4 justify-content-center">
                        <a asp-controller="Deliveries" asp-action="Create" class="text-decoration-none">
                            <div class="card box" style="width: 18rem;">
                                <img src="~/assets/Website/LoginAssets/delivery.png" class="card-img-top" alt="...">
                                <div class="card-body">
                                    <h2 class="card-text p-3 text-center text-black-50">عامل توصيل</h2>
                                </div>
                            </div>
                        </a>
                    </div>
                    <!-- card-2 -->
                    <div class="col-lg-3 col-md-4 justify-content-center">
                        <a asp-controller="StartUps" asp-action="Create" class="text-decoration-none">
                            <div class="card box" style="width: 18rem;">
                                <img src="~/assets/Website/LoginAssets/Company.png" class="card-img-top" alt="...">
                                <div class="card-body">
                                    <h2 class="card-text p-3 text-center text-black-50">شركة</h2>
                                </div>
                            </div>
                        </a>
                    </div>
                    <!-- card-3 -->
                    <div class="col-lg-3 col-md-4 justify-content-center">
                        <a asp-controller="Individuals" asp-action="Create" class="text-decoration-none">
                            <div class="card box" style="width: 18rem;">
                                <img src="~/assets/Website/LoginAssets/user.png" class="card-img-top" alt="...">
                                <div class="card-body">
                                    <h2 class="card-text p-3 text-center text-black-50">مستخدم</h2>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
            <!-- end row -->
        </div>
    </div>
    <!--end::Authentication - Sign-up-->
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
