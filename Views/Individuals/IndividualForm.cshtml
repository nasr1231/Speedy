@model IndividualFormViewModel

@{
    Layout = "_LoginLayout";
}

<form asp-action="Create" asp-controller="Deliveries">
    <div class="d-flex flex-column mb-8 fv-row fv-plugins-icon-container">
    </div>

    <div class="row mb-5">        
        <div class="w-100 w-md-50">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required"></span>الأسم الأول</label>
            <input type="text" asp-for="@Model.FirstName" class="form-control" placeholder="أدخل رقم الهاتف">
            <span asp-validation-for="@Model!.FirstName" class="text-danger d-block h-10px"></span>
        </div>
        <div class="w-100 w-md-50">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required"></span>الأسم الأخير</label>
            <input type="text" asp-for="@Model.LastName" class="form-control" placeholder="أدخل رقم الهاتف">
            <span asp-validation-for="@Model!.LastName" class="text-danger d-block h-10px"></span>
        </div>        
    </div>    

    <div class="row mb-5">
        <div class="w-100 w-md-50">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required"></span>الأيميل</label>
            <input type="text" asp-for="@Model.Email" class="form-control" placeholder="أدخل رقم الهاتف">
            <span asp-validation-for="@Model!.Email" class="text-danger d-block h-10px"></span>
        </div>
        <div class="w-100 w-md-50">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required"></span>الأسم الأخير</label>
            <input type="text" asp-for="@Model.Age" class="form-control" placeholder="أدخل رقم الهاتف">
            <span asp-validation-for="@Model!.Age" class="text-danger d-block h-10px"></span>
        </div>
    </div>

    <div class="row mb-5">
        <div class="w-100 w-md-50">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required"></span>رقم العدة بتاعتك</label>
            <input type="text" asp-for="@Model.PhoneNumber" class="form-control" placeholder="أدخل رقم الهاتف">
            <span asp-validation-for="@Model!.PhoneNumber" class="text-danger d-block h-10px"></span>
        </div>
        <div class="w-100 w-md-50">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required"></span>العنوان</label>
            <input type="text" asp-for="@Model.Address" class="form-control" placeholder="أدخل رقم الهاتف">
            <span asp-validation-for="@Model!.Address" class="text-danger d-block h-10px"></span>
        </div>
    </div>

    <div class="row mb-5">
        <div class="w-100 w-md-50">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required">Password</span></label>
            <input type="password" asp-for="Password" class="form-control" placeholder="Enter Password">
            <span asp-validation-for="@Model!.Password" class="text-danger d-block h-10px"></span>
        </div>
        <div class="w-100 w-md-50">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required">ConfirmPassword</span></label>
            <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Confirm Password">
            <span asp-validation-for="@Model!.ConfirmPassword" class="text-danger d-block h-10px"></span>
        </div>
    </div>      

    <div class="modal-footer px-0">
        <button type="submit" class="btn btn-primary">
            <span class="indicator-label">
                Save
            </span>
            <span class="indicator-progress">
                Please wait... <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
            </span>
        </button>
    </div>
</form>
