@model IndividualFormViewModel

@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Sign Up";
}

@section Styles {

}

<style>
    * {
        font-family: "IBM Plex Sans Arabic", sans-serif;
    }
    .num {
        background-color: #0d9aea;
        height: 40px;
        width: 40px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 20px;
        margin-left: 6px;
    }

    .form-control.form-control-solid {
        border-color: #92b0e6;
    }

    .nextmain {
        position: fixed;
        top: 48%;
        right: 11%;
        color: #a3a1a1;
    }

        .nextmain:hover {
            cursor: pointer;
            color: #888686;
        }

    .next {
        display: block;
        font-size: 26px;
        font-weight: 600;
        margin-right: 16px;
        color: #00000096;
    }

    .prevmain {
        position: fixed;
        top: 48%;
        left: 11%;
        color: #a3a1a1;
    }

        .prevmain:hover {
            cursor: pointer;
            color: #888686;
        }

    .prev {
        display: block;
        font-size: 26px;
        font-weight: 600;
        color: #00000096
    }

</style>

<!--begin::Main-->
<div class="d-flex flex-column flex-root">
    <!--begin::Authentication - Sign-up -->
    <div class="d-flex flex-column flex-column-fluid bgi-position-y-bottom position-x-center bgi-no-repeat bgi-size-contain bgi-attachment-fixed" style="background-image: url(/assets/Website/LoginAssets/14.png)">
        <!--begin::Content-->
        <div class="d-flex flex-center flex-column flex-column-fluid p-10 pb-lg-20">
            <!--begin::Logo-->
            <a href="../../demo5/dist/index.html" class="mb-12">
                <img alt="Speedy logo" src="" class="h-40px" />
            </a>
            <!--end::Logo-->
            <!--begin::Wrapper-->
            <div class="w-lg-600px bg-body rounded shadow-sm p-10 p-lg-15 mx-auto" style="padding-top: 30px !important">
                <!--begin::Form-->
                <form enctype="multipart/form-data" asp-action="Create" asp-controller="Deliveries" method="post" class="form w-100" novalidate="novalidate">
                    <!--begin::Heading-->
                    <div class="mb-5 text-center">
                        <!--begin::Title-->
                        <h1 class="text-dark mb-3">إنشاء حساب جديد</h1>
                        <!--end::Title-->
                        <!--begin::Link-->
                        <div class="text-gray-400 fw-bold fs-4">
                            لديك حساب بالفعل؟
                            <a href="/Identity/Account/Login" class="link-primary fw-bolder">سجل دخول هنا</a>
                        </div>
                        <!--end::Link-->
                    </div>
                    <!--end::Heading-->
                    <div class="card-body" bis_skin_checked="1">
                        <div class="slider-container">
                            <div class="slide" id="slide1">
                                <!--begin::Separator-->
                                <div class="d-flex justify-content-start align-items-center mb-7">
                                    <span class="fw-bold  fw-bolder text-white num">1</span><h3 class="align-self-end">بيانات الحساب</h3>
                                </div>
                                <!--end::Separator-->
                                <!--begin::Input group-->
                                <div class="row fv-row ">
                                    <!--begin::Col-->
                                    <div class="col-md-6 mb-7">
                                        <label class="form-label fw-bolder text-dark fs-6" asp-for="FirstName"></label>
                                        <input asp-for="FirstName" class="form-control form-control-lg form-control-solid" type="text" placeholder="" name="first-name" autocomplete="off" />
                                        <span asp-validation-for="FirstName" class="text-danger d-block h-10px"></span>
                                    </div>
                                    <!--end::Col-->
                                    <!--begin::Col-->
                                    <div class="col-md-6 mb-7">
                                        <label asp-for="LastName" class="form-label fw-bolder text-dark fs-6"></label>
                                        <input asp-for="LastName" class="form-control form-control-lg form-control-solid" type="text" placeholder="" name="last-name" autocomplete="off" />
                                        <span asp-validation-for="LastName" class="text-danger d-block h-10px"></span>
                                    </div>
                                    <!--end::Col-->
                                </div>
                                <!--end::Input group-->
                                <!--begin::Input group-->
                                <div class="fv-row mb-7">
                                    <label asp-for="Email" class="form-label fw-bolder text-dark fs-6">البريد الإلكتروني</label>
                                    <input asp-for="Email" class="form-control form-control-lg form-control-solid" type="email" placeholder="" name="email" autocomplete="off" />
                                    <span asp-validation-for="Email" class="text-danger d-block h-10px"></span>
                                </div>
                                <!--end::Input group-->
                                <!--begin::Input group-->
                                <div class="mb-10 fv-row" data-kt-password-meter="true">
                                    <!--begin::Wrapper-->
                                    <div class="mb-1">
                                        <!--begin::Label-->
                                        <label class="form-label fw-bolder text-dark fs-6">كلمة المرور</label>
                                        <!--end::Label-->
                                        <!--begin::Input wrapper-->
                                        <div class="position-relative mb-3">
                                            <input asp-for="@Model.Password" class="form-control form-control-lg form-control-solid" type="password" placeholder="" name="password" autocomplete="off" />
                                            <span class="btn btn-sm btn-icon position-absolute translate-middle top-50 start-0 me-n2" style="left: 4% !important;top: 40% !important" data-kt-password-meter-control="visibility">
                                                <i class="bi bi-eye-slash fs-2"></i>
                                                <i class="bi bi-eye fs-2 d-none"></i>
                                            </span>
                                            <span asp-validation-for="@Model!.Password" class="text-danger d-block h-10px"></span>
                                        </div>
                                        <!--end::Input wrapper-->
                                        <!--begin::Meter-->
                                        <div class="d-flex align-items-center mb-3" data-kt-password-meter-control="highlight">
                                            <div class="flex-grow-1 bg-secondary bg-active-success rounded h-5px me-2"></div>
                                            <div class="flex-grow-1 bg-secondary bg-active-success rounded h-5px me-2"></div>
                                            <div class="flex-grow-1 bg-secondary bg-active-success rounded h-5px me-2"></div>
                                            <div class="flex-grow-1 bg-secondary bg-active-success rounded h-5px"></div>
                                        </div>
                                        <!--end::Meter-->
                                    </div>
                                    <!--end::Wrapper-->
                                    <!--begin::Hint-->
                                    <div class="text-muted">استخدم 8 أحرف أو أكثر مع مزيج من الحروف والأرقام &amp; الرموز.</div>
          
                                <!--end::Hint-->
                            </div>
                            <!--end::Input group=-->
                            <!--begin::Input group-->
                            <div class="fv-row mb-5">
                                <label class="form-label fw-bolder text-dark fs-6">تأكيد كلمة المرور</label>
                                <input class="form-control form-control-lg form-control-solid" type="password" placeholder="" name="confirm-password" autocomplete="off" />
                                <span asp-validation-for="@Model!.ConfirmPassword" class="text-danger d-block h-10px"></span>
                            </div>
                            <!--end::Input group=-->
                                <a onclick="nextSlide()" class="nextmain">
                                    <i class=" fa-regular fa-circle-right fa-6x"></i>
                                    <span class="next">
                                        التالي
                                    </span>

                                </a>
                            </div>
                            <div class="slide" id="slide2">
                                <!--begin::Separator-->
                                <div class="d-flex justify-content-start align-items-center mb-7">
                                    <span class="fw-bold  fw-bolder text-white num">2</span><h3 class="align-self-end">بيانات شخصية</h3>
                                </div>
                                <!--end::Separator-->
                                <!--begin::Input group-->
                                <div class="fv-row mb-7">
                                    <label class="form-label fw-bolder text-dark fs-6">الرقم القومي</label>
                                    <input asp-for="NID" class="form-control form-control-lg form-control-solid" type="text" placeholder="" name="national-id" autocomplete="off" />
                                    <span asp-validation-for="NID" class="text-danger d-block h-10px"></span>
                                </div>
                                <!--end::Input group-->
                                <!--begin::Input group-->
                                <div class="fv-row ">
                                    <label class="form-label fw-bolder text-dark fs-6">رقم الهاتف</label>
                                    <input asp-for="@Model.MobileNumber" class="form-control form-control-lg form-control-solid" type="text" placeholder="" name="phone-number" autocomplete="off" />
                                    <span asp-validation-for="@Model!.MobileNumber" class="text-danger d-block h-10px"></span>
                                </div>
                                <!--end::Input group-->
                                <!--begin::Input group-->
                                <div class="form-check form-check-custom form-check-solid me-10 mb-7">
                                    <input asp-for="@Model.HasWhatsApp" type="checkbox" value="" class="form-check-input h-30px w-30px" id="flexCheckbox30" />
                                    <label class="form-check-label me-4" for="flexCheckbox30">
                                        هل هذا الرقم لديه واتساب؟
                                    </label>
                                </div>
                                <!--end::Input group-->
                                <!--begin::Input group-->
                                <div class="fv-row mb-7">
                                    <label class="form-label fw-bolder text-dark fs-6 ">تاريخ الميلاد</label>
                                    <div class="input-group">
                                        <input asp-for="@Model.BirthDate" type="date" name="birth-date" style="border-radius:8px;" class="form-control form-control-lg form-control-solid birthdate-flatpickr " placeholder="Username" aria-label="Username" aria-describedby="basic-addon1" />
                                        <span style="height:46px; border-radius:8px;" class="input-group-text" id="basic-addon1">
                                            <i class="fa-solid fa-calendar-days fs-4"></i>
                                        </span>
                                        <span asp-validation-for="@Model!.BirthDate" class="text-danger d-block h-10px"></span>

                                    </div>

                                </div>
                                <!--end::Input group-->
                                <!--begin::Input group-->
                                <h5 class="fv-row mb-3 form-label fw-bolder text-dark fs-6 ">النوع</h5>
                                <div class="d-flex justify-content-around mb-7">
                                    <div class="form-check form-check-inline ">
                                        <input asp-for="@Model.Gender" class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio1" value="ذكر">
                                        <label class="form-check-label fw-bolder text-dark fs-6 ">ذكر</label>
                                    </div>
                                    <div class="form-check form-check-inline ">
                                        <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio2" value="أنثى">
                                        <label class="form-check-label fw-bolder text-dark fs-6 ">انثي</label>
                                    </div>
                                    <span asp-validation-for="@Model!.Gender" class="text-danger d-block h-10px"></span>
                                </div>
                                <!--end::Input group-->
                                <!--begin::Input group-->
                                <div class="fv-row mb-7">
                                    <label class="form-label fw-bolder text-dark fs-6 ">العنوان</label>
                                    <input class="form-control form-control-lg form-control-solid" type="text" placeholder="" name="address" autocomplete="off" />
                                </div>
                                <!--end::Input group-->
                                <!--begin::Input group-->
                                <div class="row fv-row ">
                                    <div class="col-md-6 mb-7">
                                        <label class="form-label fw-bolder text-dark fs-6 " asp-for="SelectedCity"></label>
                                        <select asp-for="@Model.SelectedCity" asp-items="@Model.Cities" class="form-select form-select-solid js-select2" data-control="select2" data-placeholder="اختر المدينة" data-hide-search="true">
                                            <option></option>
                                        </select>
                                    </div>
                                    <!--end::Input group-->
                                    <!--begin::Input group-->
                                    <div class="col-md-6 mb-7">
                                        <label class="form-label fw-bolder text-dark fs-6 " asp-for="SelectedGovernorate"></label>
                                        <select asp-for="@Model.SelectedGovernorate" asp-items="@Model.Governorates" class="form-select form-select-solid js-select2" data-control="select2" data-placeholder="اختر المحافظة" data-hide-search="true">
                                            <option></option>
                                        </select>
                                    </div>
                                </div>
                                <!--begin::Input group-->
                                <div class="fv-row mb-10">
                                    <label class="form-check form-check-custom form-check-solid form-check-inline">
                                        <input class="form-check-input" type="checkbox" name="toc" value="1" />
                                        <span class="form-check-label fw-bold text-gray-700 fs-6 me-3">
                                            أقر بأني موافق على كل
                                            <a href="#" class="ms-1 link-primary">الشروط و الأحكام</a>.
                                        </span>
                                    </label>
                                </div>
                                <!--end::Input group-->
                                <!--begin::Actions-->
                                <div class="text-center">
                                    <button type="submit" id="kt_sign_up_submit" class="btn btn-lg btn-primary">
                                        <span class="indicator-label">تسجيل</span>
                                        <span class="indicator-progress">
                                            برجاء الانتظار
                                            <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                                        </span>
                                    </button>
                                </div>
                                <a onclick="prevSlide()" class="prevmain">
                                    <i class=" fa-regular fa-circle-left fa-6x"></i>
                                    <span class="prev">
                                        السابق
                                    </span>

                                </a>
                            </div>
                        </div>
                    </div>

                </form>
                <!--end::Form-->
            </div>
            <!--end::Wrapper-->
        </div>
        <!--end::Content-->
        <!--begin::Footer-->
        <div class="d-flex flex-center flex-column-auto p-10">
            <!--begin::Links-->
            <div class="d-flex align-items-center fw-bold fs-6">
                <a href="https://keenthemes.com" class="text-muted text-hover-primary px-2">About</a>
                <a href="mailto:support@keenthemes.com" class="text-muted text-hover-primary px-2">Contact</a>
                <a href="https://1.envato.market/EA4JP" class="text-muted text-hover-primary px-2">Contact Us</a>
            </div>
            <!--end::Links-->
        </div>
        <!--end::Footer-->
    </div>
    <!--end::Authentication - Sign-up-->
</div>



@section Scripts {
    <script src="~/js/slider.js" asp-asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $(".birthdate-flatpickr").flatpickr(
                {
                    "autoApply": true,
                    "showDropdowns": true,
                    "drops": 'up',
                    "disable": [
                        function (date) {
                            let currentDate = new Date(new Date().getFullYear() - 16, 11, 31);
                            // return true to disable
                            return (date >= currentDate)
                        }
                    ],
                }
            )
        });
    </script>
}