<!-- ***** Header Area Start ***** -->
<header class="header-area header-sticky wow slideInDown" data-wow-duration="0.75s" data-wow-delay="0s">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <nav class="main-nav">
                    <!-- ***** Logo Start ***** -->
                    <a href="index.html" class="logo">
                        <img src="assets/images/logo.png" alt="Chain App Dev">
                    </a>
                    <!-- ***** Logo End ***** -->
                    <!-- ***** Menu Start ***** -->
                    <ul class="nav">
                        <li class="scroll-to-section">
                            <a asp-controller="Home" asp-action="Index" class="active">الصفحه الرئيسيه</a>
                        </li>
                        <li class="scroll-to-section"><a asp-controller="Deliveries" asp-action="Dashboard">مناديب</a></li>
                        <li class="scroll-to-section"><a href="#services">طلبات</a></li>
                        <li class="scroll-to-section"><a href="#about">مدفوعات</a></li>
                        <li class="scroll-to-section"><a href="#newsletter">عنا</a></li>
                    </ul>
                    <div class="gradient-button">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <span>
                                @User.FindFirst(ClaimTypes.Role)!.Value
                            </span>
                        }
                        else
                        {
                            <a id="modal_trigger" href="Identity/Account/login">
                                <i class="fa fa-sign-in-alt"></i>
                                تسجيل الدخول
                            </a>
                            <a id="modal_trigger" asp-action="Register">
                                <i class="fa fa-sign-in-alt"></i>
                                سجل الآن
                            </a>
                        }
                    </div>

                    <a class='menu-trigger'>
                        <span>Menu</span>
                    </a>
                    <!-- ***** Menu End ***** -->
                </nav>
            </div>
        </div>
    </div>
</header>
<!-- ***** Header Area End ***** -->