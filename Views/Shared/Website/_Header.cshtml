<style>
    
    }
    :root {
        --main-orange: #E25E3E;
        --sec-orange: #da6b16;
        --dark: #01153e;
    }
    .header-area .main-nav .nav li a {
        font-size: 20px;
    }

    .header-area .main-nav .nav li:last-child a:hover,
    .background-header .main-nav .nav li:last-child a:hover,
    .header-area .main-nav .nav li:nth-child(6) a:hover,
    .background-header .main-nav .nav li:nth-child(6) a:hover {
        color: var(--main-orange);
    }

    #head {
        background-color: white;
    }

    #m-btn {
        color: var(--main-orange);
        background-color: white;
        border: 1px solid var(--main-orange);
    }

    .service-item p {
        font-size: 20px;
        color: var(--dark);
        font-weight: 401;
    }

    .cond {
        color: rgb(246 84 3);
    }

    .about-us:after {
        background-image: url(~/images/about-bg-new.jpg);
    }

</style>

<!-- ***** Header Area Start ***** -->

<header class="header-area header-sticky wow slideInDown" data-wow-duration="0.75s" data-wow-delay="0s" id="head">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <nav class="main-nav">
                    <!-- ***** Logo Start ***** -->
                    <a href="index.html" class="logo ">
                        
                        <img src="~/assets/website/images/final-logo.png"   style="width:115px;" />
                    </a>
                    <!-- ***** Logo End ***** -->
                    <!-- ***** Menu Start ***** -->
                    @{
                        if (SignInManager.IsSignedIn(User))
                        {
                            var role = User.FindFirst(ClaimTypes.Role)!.Value;
                            var userId = User.FindFirst(ClaimTypes.NameIdentifier)!.Value;
                            @if ( role == AppRoles.Individual)
                            {
                                <ul class="nav text-white">
                                    <li class="scroll-to-section">
                                        <a asp-controller="Home" asp-action="Index" class="active px-4">الصفحه الرئيسيه</a>
                                    </li>
                                    <li class="scroll-to-section"><a asp-controller="Deliveries" asp-action="Dashboard" class="px-6">مناديب</a></li>
                                    <li class="scroll-to-section"><a asp-controller="Orders" asp-action="Index" class="px-6">طلبات</a></li>
                                    <li class="scroll-to-section"><a asp-route-id="@userId" asp-controller="Individuals" asp-action="Profile" class="px-6">حسابي</a></li>
                                    <li><a asp-controller="FeedBacks" asp-action="Index" class="px-6">رأيك عنا</a></li>
                                </ul>
                            }
                            else if (role == AppRoles.StartUp)
                            {
                                <ul class="nav text-white">
                                    <li class="scroll-to-section">
                                        <a asp-controller="Home" asp-action="Index" class="active px-4">الصفحه الرئيسيه</a>
                                    </li>
                                    <li class="scroll-to-section"><a asp-controller="Deliveries" asp-action="Dashboard" class="px-6">مناديب</a></li>
                                    <li class="scroll-to-section"><a asp-controller="Orders" asp-action="Index" class="px-6">طلبات</a></li>
                                    <li class="scroll-to-section"><a asp-route-id="@userId" asp-controller="StartUps" asp-action="Profile" class="px-6">حسابي</a></li>
                                    <li><a asp-controller="FeedBacks" asp-action="Index" class="px-6">رأيك عنا</a></li>
                                </ul>
                            }
                            else
                            {
                                <ul class="nav text-white">
                                    <li class="scroll-to-section">
                                        <a asp-controller="Home" asp-action="Index" class="active px-4">الصفحه الرئيسيه</a>
                                    </li>
                                    <li class="scroll-to-section"><a asp-controller="Deliveries" asp-action="Dashboard" class="px-6">مناديب</a></li>
                                    <li><a asp-controller="FeedBacks" asp-action="Index" class="px-6">رأيك عنا</a></li>
                                </ul>
                            }
                        }
                        else
                        {
                            <ul class="nav text-white">
                                <li class="scroll-to-section">
                                    <a asp-controller="Home" asp-action="Index" class="active px-4">الصفحه الرئيسيه</a>
                                </li>
                                <li class="scroll-to-section"><a asp-controller="Deliveries" asp-action="Dashboard" class="px-6">مناديب</a></li>
                                <li class="scroll-to-section"><a asp-controller="Orders" asp-action="Index" class="px-6">طلبات</a></li>
                                <li class="scroll-to-section"><a id="ab" href="#about" class="px-7">عنا</a></li>
                            </ul>
                        }
                    }
                    <a class='menu-trigger'>
                        <span>Menu</span>
                    </a>
                    <div class="btn rounded-pill" id="m-btn">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <div class="cursor-pointer me-5 symbol symbol-30px symbol-lg-40px border border-gray-500 shadow-sm" data-kt-menu-trigger="{default: 'click', lg: 'hover'}" data-kt-menu-attach="parent" data-kt-menu-placement="bottom-start">
                                <form id="SignOut" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/">
                                    <button type="submit" style="color:black; " class="btn bg-white text-black btn-sm align-self-center ps-2">
                                        تسجيل الخروج
                                        <i class="fa-solid fa-right-from-bracket px-3"></i>
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <a id="modal_trigger" href="Identity/Account/login" style="color: #E25E3E !important;">
                                <i class="fa fa-sign-in-alt"></i>
                                تسجيل الدخول
                            </a>
                        }
                    </div>
                </nav>
            </div>
        </div>
    </div>
</header>
<!-- ***** Header Area End ***** -->