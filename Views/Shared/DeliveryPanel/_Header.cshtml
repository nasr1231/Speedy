<!--begin::Header-->
<div id="kt_app_header" class="app-header d-flex flex-column flex-stack">
    <!--begin::Header main-->
    <div class="d-flex align-items-center flex-stack flex-grow-1" style="background-color:rgb(255 248 229);">
        <div class="app-header-logo d-flex align-items-center flex-stack px-lg-11 mb-2 h-100" id="kt_app_header_logo">
            <!--begin::Sidebar mobile toggle-->
            <div class="btn btn-icon btn-active-color-primary w-35px h-35px ms-3 me-2 d-flex d-lg-none" id="kt_app_sidebar_mobile_toggle">
                <i class="fa-solid fa-bars fs-2"></i>
                    <span class="path1"></span>
                    <span class="path2"></span>
                </i>
            </div>
            <!--end::Sidebar mobile toggle-->
            <!--begin::Logo-->
            <a asp-controller="Home" asp-action="Index" class="active px-4">
                <img src="~/assets/website/images/final-logo.png" style="width:100px;" />
            </a>
            <!--end::Logo-->
            <!--begin::Sidebar toggle-->
            <div id="kt_app_sidebar_toggle" class="app-sidebar-toggle btn btn-sm btn-icon  me-n2 d-none d-lg-flex" data-kt-toggle="true" data-kt-toggle-state="active" data-kt-toggle-target="body" data-kt-toggle-name="app-sidebar-minimize">
                <i class="fa-solid fa-signs-post fs-2 text-50-black"></i>
            </div>
            <!--end::Sidebar toggle-->
        </div>
        <!--begin::Navbar-->
        <div class="app-navbar flex-grow-1 justify-content-end" id="kt_app_header_navbar">
            <!--begin::User menu-->
            <div class="app-navbar-item me-7 ms-lg-2" id="kt_header_user_menu_toggle">
                <div class="d-flex flex-column justify-content-center me-3 text-end">                   
                </div>
                <div class="cursor-pointer me-5 symbol symbol-30px symbol-lg-40px border border-gray-500 shadow-sm" data-kt-menu-trigger="{default: 'click', lg: 'hover'}" data-kt-menu-attach="parent" data-kt-menu-placement="bottom-start">                    
                    <form id="SignOut" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/">                        
                        <button type="submit" class="btn btn-sm align-self-center pe-0">
                            تسجيل الخروج
                            <i class="fa-solid fa-right-from-bracket px-3"></i>
                        </button>
                    </form>                   
                </div>                
                <!--end::Menu wrapper-->
            </div>           
        </div>
        <!--end::Navbar-->
    </div>
    <!--end::Header main-->    
</div>
