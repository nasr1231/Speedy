<!DOCTYPE html>
<html dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!--Global Fonts -->
    @*Arabic Font to be added here*@
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@100;200;300;400;500;600;700&display=swap" crossorigin="anonymous">
    <!--End::Global Fonts -->
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/assets/Panel/css/plugins.bundle.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/assets/Panel/css/style.bundle.css" crossorigin="anonymous" />    
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/assets/Website/css/Style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        *{
            direction: rtl !important;
            font-family: "IBM Plex Sans Arabic", sans-serif;
        }
    </style>
    <link rel="stylesheet" href="~/Speedy.styles.css" asp-append-version="true" crossorigin="anonymous" />
</head>
<body>

    @RenderBody()

    <span id="message" class="d-none">@TempData["Message"]</span>    
    @* <script src="~/lib/jquery/dist/jquery.min.js"></script> *@
    <script src="~/lib/font-awesome/js/all.min.js"></script>    
    <script src="~/assets/panel/js/plugins.bundle.js"></script>
    <script src="~/assets/panel/js/scripts.bundle.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Plugins", required: false)
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
