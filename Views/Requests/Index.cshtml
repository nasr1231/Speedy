@model RequestDetailsViewModel


<input type="hidden" asp-for="DeliveryId" />

<div id="kt_app_content_container" class="app-container  container-xxl " bis_skin_checked="1">

    <!--begin::Navbar-->
    <div class="card mb-5 mb-xxl-8" bis_skin_checked="1">
        <div class="card-body pt-9 pb-0" bis_skin_checked="1">
            <!--begin::Details-->
            <div class="d-flex flex-wrap flex-sm-nowrap" bis_skin_checked="1">
                <!--begin: Pic-->
                <div class="me-7 mb-4" bis_skin_checked="1">
                    <div class="symbol symbol-100px symbol-lg-160px symbol-fixed position-relative" bis_skin_checked="1">
                        <img src="~/attachments/@Model.AppUser.ProfilePictureIUrl" alt="image">
                        <div class="position-absolute translate-middle bottom-0 start-100 mb-6 bg-success rounded-circle border border-4 border-body h-20px w-20px" bis_skin_checked="1"></div>
                    </div>
                </div>
                <!--end::Pic-->
                <!--begin::Info-->
                <div class="flex-grow-1" bis_skin_checked="1">
                    <!--begin::Title-->
                    <div class="d-flex justify-content-between align-items-start flex-wrap mb-2" bis_skin_checked="1">
                        <!--begin::User-->
                        <div class="d-flex flex-column" bis_skin_checked="1">
                            <!--begin::Name-->
                            <div class="d-flex align-items-center mb-2" bis_skin_checked="1">
                                <a href="#" class="text-gray-900 text-hover-primary fs-2 fw-bold me-1">@Model.AppUser.FirstName @Model.AppUser.LastName</a>
                                <a href="#"><i class="ki-duotone ki-verify fs-1 text-primary"><span class="path1"></span><span class="path2"></span></i></a>
                            </div>
                            <!--end::Name-->
                            <!--begin::Info-->
                            <div class="d-flex flex-wrap fw-semibold fs-6 mb-4 pe-2" bis_skin_checked="1">
                                <span class="d-flex align-items-center text-gray-500 me-5 mb-2">
                                    <i class="ki-duotone ki-profile-circle fs-4 me-1"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i> 
                                    @Model.AppUser.Address
                                </a>
                            </div>
                            <!--end::Info-->
                        </div>
                        <!--end::User-->
                        <!--begin::Actions-->
                        <div class="d-flex my-4" bis_skin_checked="1">
                            <a asp-action="" asp-controller="Requests" class="btn btn-md btn-danger me-2" id="kt_user_follow_button">
                                Reject
                            </a>
                            <a asp-action="" asp-controller="Requests" class="btn btn-md btn-success me-3">Accept</a>
                        </div>
                        <!--end::Actions-->
                    </div>
                    <!--end::Title-->
                    <!--begin::Stats-->
                    <div class="d-flex flex-wrap flex-stack" bis_skin_checked="1">
                        <!--begin::Wrapper-->
                        <div class="d-flex flex-column flex-grow-1 pe-8" bis_skin_checked="1">
                            <!--begin::Stats-->
                            <div class="d-flex flex-wrap" bis_skin_checked="1">
                                <!--begin::Stat-->
                                <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3" bis_skin_checked="1">
                                    <!--begin::Number-->
                                    <div class="d-flex align-items-center" bis_skin_checked="1">
                                        <i class="ki-duotone ki-arrow-up fs-3 text-success me-2"><span class="path1"></span><span class="path2"></span></i>                                    <div class="fs-2 fw-bold counted" data-kt-countup="true" data-kt-countup-value="4500" data-kt-countup-prefix="$" data-kt-initialized="1" bis_skin_checked="1">0</div>
                                    </div>
                                    <!--end::Number-->
                                    <!--begin::Label-->
                                    <div class="fw-semibold fs-6 text-gray-500" bis_skin_checked="1">Earnings</div>
                                    <!--end::Label-->
                                </div>
                                <!--end::Stat-->
                                <!--begin::Stat-->
                                <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3" bis_skin_checked="1">
                                    <!--begin::Number-->
                                    <div class="d-flex align-items-center" bis_skin_checked="1">
                                        <i class="ki-duotone ki-arrow-down fs-3 text-danger me-2"><span class="path1"></span><span class="path2"></span></i>                                    <div class="fs-2 fw-bold counted" data-kt-countup="true" data-kt-countup-value="0" data-kt-initialized="1" bis_skin_checked="1">0</div>
                                    </div>
                                    <!--end::Number-->
                                    <!--begin::Label-->
                                    <div class="fw-semibold fs-6 text-gray-500" bis_skin_checked="1">Orders</div>
                                    <!--end::Label-->
                                </div>
                                <!--end::Stat-->
                                <!--begin::Stat-->
                                <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3" bis_skin_checked="1">
                                    <!--begin::Number-->
                                    <div class="d-flex align-items-center" bis_skin_checked="1">
                                        <i class="ki-duotone ki-arrow-up fs-3 text-success me-2"><span class="path1"></span><span class="path2"></span></i>                                    <div class="fs-2 fw-bold counted" data-kt-countup="true" data-kt-countup-value="60" data-kt-countup-prefix="%" data-kt-initialized="1" bis_skin_checked="1">0</div>
                                    </div>
                                    <!--end::Number-->
                                    <!--begin::Label-->
                                    <div class="fw-semibold fs-6 text-gray-500" bis_skin_checked="1">Review</div>
                                    <!--end::Label-->
                                </div>
                                <!--end::Stat-->
                            </div>
                            <!--end::Stats-->
                        </div>
                        <!--end::Wrapper-->
                    </div>
                    <!--end::Stats-->
                </div>
                <!--end::Info-->
            </div>
            <!--end::Details-->
            <!--begin::Navs-->
            <ul class="nav nav-stretch nav-line-tabs nav-line-tabs-2x border-transparent fs-5 fw-bold w-100">
                <!--begin::Nav item-->
                <li class="nav-item mt-2" role="presentation">
                    <a class="nav-link text-active-primary ms-0 me-10 py-5 active"
                       data-bs-toggle="tab"
                       href="#Personal_Details" role="tab">
                        Details
                    </a>
                </li>
                <!--end::Nav item-->
                <!--begin::Nav item-->
                <li class="nav-item mt-2" role="presentation">
                    <a class="nav-link text-active-primary ms-0 me-10 py-5"
                       data-bs-toggle="tab" role="tab"
                       href="#Settings">
                        Documents
                    </a>
                </li>
                <!--end::Nav item-->
            </ul>
            <!--begin::Navs-->
        </div>
    </div>
    <!--end::Navbar-->
    <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade active show" id="Personal_Details" role="tabpanel">
            <div class="card">
                <div class="col-12 col-md-6">
                    <!--begin::Card-->
                    <div class="card border-gray-300 h-100">
                        <!--begin::Card body-->
                        <div class="card-body d-flex justify-content-center text-center flex-column p-8">
                            <!--begin::Name-->
                            <a href="" class="text-gray-800 text-hover-primary d-flex flex-column align-items-center" download>
                                <!--begin::Image-->
                                <div class="symbol mb-5">
                                    <img style="width:55px;height:70px;" src="~/attachments/" />
                                </div>
                                <!--end::Image-->
                                <!--begin::Title-->
                                <div class="fs-5 fw-bold mb-2">
                                    @Model.CriminalStatus
                                </div>
                                <!--end::Title-->
                            </a>
                            <!--end::Name-->
                        </div>
                        <!--end::Card body-->
                    </div>
                    <!--end::Card-->
                </div>
            </div>
        </div>
    </div>
    <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade" id="Settings" role="tabpanel">
            <div class="card">
            </div>
        </div>
    </div>


</div>