@model RequestDetailsViewModel


<input type="hidden" asp-for="DeliveryId" />

<div id="kt_app_content_container" class="app-container  container-xxl " bis_skin_checked="1">

    <!--begin::Navbar-->
    <div class="card mb-5 mb-xxl-8" bis_skin_checked="1">
        <div class="card-body pt-9 pb-0" bis_skin_checked="1">
            <!--begin::Details-->
            <div class="d-flex flex-wrap flex-sm-nowrap" bis_skin_checked="1">
                <!--begin: Pic-->
                <div class="me-7 mb-4" bis_skin_checked="1">
                    <div class="symbol symbol-100px symbol-lg-160px symbol-fixed position-relative" bis_skin_checked="1">
                        <img src="@Model.AppUser!.ProfilePictureIUrl" alt="image">
                        <div class="position-absolute translate-middle bottom-0 start-100 mb-6 bg-success rounded-circle border border-4 border-body h-20px w-20px" bis_skin_checked="1"></div>
                    </div>
                </div>
                <!--end::Pic-->
                <!--begin::Info-->
                <div class="flex-grow-1" bis_skin_checked="1">
                    <!--begin::Title-->
                    <div class="d-flex justify-content-between align-items-start flex-wrap mb-2" bis_skin_checked="1">
                        <!--begin::User-->
                        <div class="d-flex flex-column" bis_skin_checked="1">
                            <!--begin::Name-->
                            <div class="d-flex align-items-center mb-2" bis_skin_checked="1">
                                <span class="text-gray-900 fs-2 fw-bold me-1">@Model.AppUser.FirstName @Model.AppUser.LastName</span>
                                <span><i class="ki-duotone ki-verify fs-1 text-primary"><span class="path1"></span><span class="path2"></span></i></a>
                            </div>
                            <!--end::Name-->
                            <!--begin::Info-->
                            <div class="d-flex flex-wrap fw-semibold fs-6 mb-4 pe-2" bis_skin_checked="1">
                                <span class="d-flex align-items-center text-gray-500 me-5 mb-2">
                                    @Model.AppUser.Address
                                </span>
                            </div>
                            <!--end::Info-->
                        </div>
                        <!--end::User-->
                        <!--begin::Actions-->
                        <div class="d-flex my-4" bis_skin_checked="1">
                            <form method="post" asp-action="Reject" asp-route-id="@Model.DeliveryId" asp-controller="Requests">
                                <button type="submit" class="btn btn-md btn-danger me-2">
                                    Reject
                                </button>
                            </form>

                            <form method="post" asp-action="Accept" asp-route-id="@Model.DeliveryId" asp-controller="Requests">
                                <button type="submit" class="btn btn-md btn-success me-2">
                                    Accept
                                </button>
                            </form>
                        </div>
                        <!--end::Actions-->
                    </div>
                    <!--end::Title-->
                    <!--begin::Stats-->
                    <div class="d-flex flex-wrap flex-stack" bis_skin_checked="1">
                        <!--begin::Wrapper-->
                        <div class="d-flex flex-column flex-grow-1 pe-8" bis_skin_checked="1">
                            <!--begin::Stats-->
                            <div class="d-flex flex-wrap" bis_skin_checked="1">
                                <!--begin::Stat-->
                                <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3" bis_skin_checked="1">
                                    <!--begin::Number-->
                                    <div class="d-flex align-items-center" bis_skin_checked="1">
                                        <i class="ki-duotone ki-arrow-up fs-3 text-success me-2"><span class="path1"></span><span class="path2"></span></i>                                    <div class="fs-2 fw-bold counted" data-kt-countup="true" data-kt-countup-value="4500" data-kt-countup-prefix="$" data-kt-initialized="1" bis_skin_checked="1">0</div>
                                    </div>
                                    <!--end::Number-->
                                    <!--begin::Label-->
                                    <div class="fw-semibold fs-6 text-gray-500" bis_skin_checked="1">Earnings</div>
                                    <!--end::Label-->
                                </div>
                                <!--end::Stat-->
                                <!--begin::Stat-->
                                <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3" bis_skin_checked="1">
                                    <!--begin::Number-->
                                    <div class="d-flex align-items-center" bis_skin_checked="1">
                                        <i class="ki-duotone ki-arrow-down fs-3 text-danger me-2"><span class="path1"></span><span class="path2"></span></i>                                    <div class="fs-2 fw-bold counted" data-kt-countup="true" data-kt-countup-value="0" data-kt-initialized="1" bis_skin_checked="1">0</div>
                                    </div>
                                    <!--end::Number-->
                                    <!--begin::Label-->
                                    <div class="fw-semibold fs-6 text-gray-500" bis_skin_checked="1">Orders</div>
                                    <!--end::Label-->
                                </div>
                                <!--end::Stat-->
                                <!--begin::Stat-->
                                <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3" bis_skin_checked="1">
                                    <!--begin::Number-->
                                    <div class="d-flex align-items-center" bis_skin_checked="1">
                                        <i class="ki-duotone ki-arrow-up fs-3 text-success me-2"><span class="path1"></span><span class="path2"></span></i>                                    <div class="fs-2 fw-bold counted" data-kt-countup="true" data-kt-countup-value="60" data-kt-countup-prefix="%" data-kt-initialized="1" bis_skin_checked="1">0</div>
                                    </div>
                                    <!--end::Number-->
                                    <!--begin::Label-->
                                    <div class="fw-semibold fs-6 text-gray-500" bis_skin_checked="1">Review</div>
                                    <!--end::Label-->
                                </div>
                                <!--end::Stat-->
                            </div>
                            <!--end::Stats-->
                        </div>
                        <!--end::Wrapper-->
                    </div>
                    <!--end::Stats-->
                </div>
                <!--end::Info-->
            </div>
            <!--end::Details-->
            <!--begin::Navs-->
            <ul class="nav nav-stretch nav-line-tabs nav-line-tabs-2x border-transparent fs-5 fw-bold w-100">
                <!--begin::Nav item-->
                <li class="nav-item mt-2" role="presentation">
                    <a class="nav-link text-active-primary ms-0 me-10 py-5 active"
                       data-bs-toggle="tab"
                       href="#Personal_Details" role="tab">
                        Details
                    </a>
                </li>
                <!--end::Nav item-->
                <!--begin::Nav item-->
                <li class="nav-item mt-2" role="presentation">
                    <a class="nav-link text-active-primary ms-0 me-10 py-5"
                       data-bs-toggle="tab" role="tab"
                       href="#Settings">
                        Documents
                    </a>
                </li>
                <!--end::Nav item-->
            </ul>
            <!--begin::Navs-->
        </div>
    </div>
    <!--end::Navbar-->
    <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade active show" id="Personal_Details" role="tabpanel">
            <div class="card">
                <!--begin::Card-->
                <div class="card border-gray-300 h-100">
                    <div class="row w-100">

                        <div class="row">
                            <div class="col-6">
                                <div class="card-body p-9" bis_skin_checked="1">
                                    <!--begin::Row-->
                                    <div class="row mb-7" bis_skin_checked="1">
                                        <!--begin::Label-->
                                        <label class="col-lg-4 fw-semibold text-muted">Full Name</label>
                                        <!--end::Label-->
                                        <!--begin::Col-->
                                        <div class="col-lg-8" bis_skin_checked="1">
                                            <span class="fw-bold fs-6 text-gray-800">@Model.AppUser.FirstName @Model.AppUser.LastName</span>
                                        </div>
                                        <!--end::Col-->
                                    </div>
                                    <!--end::Row-->
                                    <!--begin::Input group-->
                                    <div class="row mb-7" bis_skin_checked="1">
                                        <!--begin::Label-->
                                        <label class="col-lg-4 fw-semibold text-muted">Gender</label>
                                        <!--end::Label-->
                                        <!--begin::Col-->
                                        <div class="col-lg-8 fv-row" bis_skin_checked="1">
                                            <span class="fw-semibold text-gray-800 fs-6">@Model.AppUser.Gender</span>
                                        </div>
                                        <!--end::Col-->
                                    </div>
                                    <!--end::Input group-->
                                    <!--begin::Input group-->
                                    <div class="row mb-7" bis_skin_checked="1">
                                        <!--begin::Label-->
                                        <label class="col-lg-4 fw-semibold text-muted">
                                            Phone Number

                                            <span class="ms-1" data-bs-toggle="tooltip" aria-label="Phone number must be active" data-bs-original-title="Phone number must be active" data-kt-initialized="1">
                                                <i class="ki-duotone ki-information fs-7"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i>
                                            </span>
                                        </label>
                                        <!--end::Label-->
                                        <!--begin::Col-->
                                        <div class="col-lg-8 d-flex align-items-center" bis_skin_checked="1">
                                            <span class="fw-bold fs-6 text-gray-800 me-2">@Model.AppUser.PhoneNumber</span>
                                            <span class="badge badge-success">Verified</span>
                                        </div>
                                        <!--end::Col-->
                                    </div>
                                    <!--end::Input group-->
                                    <!--begin::Input group-->
                                    <div class="row mb-7" bis_skin_checked="1">
                                        <!--begin::Label-->
                                        <label class="col-lg-4 fw-semibold text-muted">Birth Date</label>
                                        <!--end::Label-->
                                        <!--begin::Col-->
                                        <div class="col-lg-8" bis_skin_checked="1">
                                            <span class="fw-semibold fs-6 text-gray-800 text-hover-primary" @Model.AppUser.BirthDate</span>
                                        </div>
                                        <!--end::Col-->
                                    </div>
                                    <!--end::Input group-->
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="card-body p-9" bis_skin_checked="1">
                                    <!--begin::Row-->
                                    <div class="row mb-7" bis_skin_checked="1">
                                        <!--begin::Label-->
                                        <label class="col-lg-4 fw-semibold text-muted">Email</label>
                                        <!--end::Label-->
                                        <!--begin::Col-->
                                        <div class="col-lg-8" bis_skin_checked="1">
                                            <span class="fw-bold fs-6 text-gray-800">@Model.AppUser.Email</span>
                                        </div>
                                        <!--end::Col-->
                                    </div>
                                    <!--end::Row-->
                                    <!--begin::Input group-->
                                    <div class="row mb-7" bis_skin_checked="1">
                                        <!--begin::Label-->
                                        <label class="col-lg-4 fw-semibold text-muted">
                                            National Id

                                            <span class="ms-1" data-bs-toggle="tooltip" aria-label="Country of origination" data-bs-original-title="Country of origination" data-kt-initialized="1">
                                                <i class="ki-duotone ki-information fs-7"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i>
                                            </span>
                                        </label>
                                        <!--end::Label-->
                                        <!--begin::Col-->
                                        <div class="col-lg-8" bis_skin_checked="1">
                                            <span class="fw-bold fs-6 text-gray-800">@Model.AppUser.NID</span>
                                        </div>
                                        <!--end::Col-->
                                    </div>
                                    <!--end::Input group-->
                                    <!--begin::Input group-->
                                    <div class="row mb-7" bis_skin_checked="1">
                                        <!--begin::Label-->
                                        <label class="col-lg-4 fw-semibold text-muted">Address</label>
                                        <!--end::Label-->
                                        <!--begin::Col-->
                                        <div class="col-lg-8" bis_skin_checked="1">
                                            <span class="fw-bold fs-6 text-gray-800">@Model.AppUser.Address</span>
                                        </div>
                                        <!--end::Col-->
                                    </div>
                                    <!--end::Input group-->
                                    <!--begin::Input group-->
                                    <div class="row mb-10" bis_skin_checked="1">
                                        <!--begin::Label-->
                                        <label class="col-lg-4 fw-semibold text-muted">Has Whatsapp</label>
                                        <!--begin::Label-->
                                        <!--begin::Label-->
                                        <div class="col-lg-8" bis_skin_checked="1">
                                            <span class="fw-semibold fs-6 text-gray-800">
                                                <span class="badge badge-@(Model.HasWhatsApp ? "success" : "danger")">
                                                    @(Model.HasWhatsApp ? "Yes" : "No")
                                                </span>
                                            </span>
                                        </div>
                                        <!--begin::Label-->
                                    </div>
                                    <!--end::Input group-->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!--end::Card-->

            </div>
        </div>
    </div>
    <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade" id="Settings" role="tabpanel">
            <div class="card">
                <div class="col-12 col-md-6">
                    <!--begin::Card-->
                    <div class="card border-gray-300 h-100">
                        <!--begin::Card body-->
                        <div class="card-body d-flex justify-content-center text-center flex-column p-8">
                            <div class="row">
                                <div class="col-6">
                                    <!--begin::Name-->
                                    <a href="@Model.CriminalStatus" class="text-gray-800 text-hover-primary d-flex flex-column align-items-center" download>
                                        <!--begin::Image-->
                                        <div class="symbol mb-5">
                                            <img class="w-100 h-100" src="@Model.CriminalStatus" />
                                        </div>
                                        <!--end::Image-->
                                        <!--begin::Title-->
                                        <div class="fs-5 fw-bold mb-2">
                                            الفيش والتشبيه
                                        </div>
                                        <!--end::Title-->
                                    </a>
                                    <!--end::Name-->
                                </div>
                                <div class="col-6">
                                    <!--begin::Name-->
                                    <a href="@Model.NationalId" class="text-gray-800 text-hover-primary d-flex flex-column align-items-center" download>
                                        <!--begin::Image-->
                                        <div class="symbol mb-5">
                                            <img class="w-100 h-100" src="@Model.NationalId" />
                                        </div>
                                        <!--end::Image-->
                                        <!--begin::Title-->
                                        <div class="fs-5 fw-bold mb-2">
                                            البطاقة الشخصية
                                        </div>
                                        <!--end::Title-->
                                    </a>
                                    <!--end::Name-->
                                </div>
                            </div>

                        </div>
                        <!--end::Card body-->
                    </div>
                    <!--end::Card-->
                </div>
            </div>
        </div>
    </div>


</div>