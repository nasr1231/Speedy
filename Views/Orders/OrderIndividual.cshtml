@{
    Layout = "_StartLayout";
    ViewData["Title"] = "الطلبات";
}
<div class="main d-flex flex-column align-items-center flex-column-fluid justify-content-center">
    <h1 class="mb-4">إبدأ تجربة توصيل سريعة معنا الآن</h1>
    <div class=" d-flex w-100 mb-4 justify-content-center ">
        <div class=" d-flex flex-column flex-md-row justify-content-center align-items-center">
            <div class="fv-row">
                <div class="input-group">
                    <input type="text" placeholder="أدخل عنوانك بالكامل هنا" style="border-radius:8px; border-top-left-radius:0;border-bottom-left-radius: 0;" class="form-control form-control-lg form-control-solid border-gray-400" aria-label="location" aria-describedby="basic-addon1" />
                    <span style="border-radius:8px; border-top-right-radius:0; border-bottom-right-radius: 0;" class="input-group-text border-gray-400" id="basic-addon1">
                        <i class="fa-solid fa-location-dot fs-4"></i>
                    </span>

                </div>

            </div>
            <button class="btn m-5" style="border-radius:8px;">أدخل موقعك وتابع</button>
        </div>
    </div>
</div>


<a asp-controller="Orders" asp-action="Agents" class="btn btn-danger">خشي من هنا على الفورم ياعمدة</a>