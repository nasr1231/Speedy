    <script>
        $.validator.setDefaults({
            ignore: []
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const titleInput = document.getElementById('Title');

            const radioButtons = document.querySelectorAll('input[name="payment-method"]');

            radioButtons.forEach(radio => {
                radio.addEventListener('change', function () {
                    if (this.checked) {
                        titleInput.value = this.value;
                    }
                });
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            $("#js-Order-flatpicker").flatpickr({
                singleDatePicker: true,
                autoApply: true,
                showDropdowns: true,
                drops: 'up',
                minDate: new Date(),
                enableTime: true,
                dateFormat: "Y-m-d H:i",
            });
        });

        // document.addEventListener('DOMContentLoaded', function () {
        //     var instapayInputs = $('#InstaPay input');
        //     var digitalWalletsInputs = $('#DigitalWalletsDiv input');
        //     var bankAccountInputs = $('#BankAccountDiv .flex-row-fluid input');

        //     $('input[name="payment-method"]').change(function () {
        //         var selectedRadio = $(this).attr('id');

        //         instapayInputs.prop('required', false);
        //         digitalWalletsInputs.prop('required', false);
        //         bankAccountInputs.prop('required', false);

        //         if (selectedRadio === 'instapay') {
        //             instapayInputs.prop('required', true);
        //         } else if (selectedRadio === 'digital-wallets') {
        //             digitalWalletsInputs.prop('required', true);
        //         } else if (selectedRadio === 'bank-account') {
        //             bankAccountInputs.prop('required', true);
        //         }
        //     });
        // });

        const cashRadio = document.getElementById('cash');
        const bankAccountRadio = document.getElementById('bank-account');
        const digitalWalletsRadio = document.getElementById('digital-wallets');
        const instapayRadio = document.getElementById('instapay');
        const cashDiv = document.getElementById('CashDiv');
        const bankAccountDiv = document.getElementById('BankAccountDiv');
        const digitalWalletsDiv = document.getElementById('DigitalWalletsDiv');
        const instapayDiv = document.getElementById('InstaPay');

        cashRadio.addEventListener('change', function () {
            if (this.checked) {
                cashDiv.style.display = 'block';
                bankAccountDiv.style.display = 'none';
                digitalWalletsDiv.style.display = 'none';
                instapayDiv.style.display = 'none';
            }
        });

        bankAccountRadio.addEventListener('change', function () {
            if (this.checked) {
                cashDiv.style.display = 'none';
                bankAccountDiv.style.display = 'block';
                digitalWalletsDiv.style.display = 'none';
                instapayDiv.style.display = 'none';
            }
        });

        digitalWalletsRadio.addEventListener('change', function () {
            if (this.checked) {
                cashDiv.style.display = 'none';
                bankAccountDiv.style.display = 'none';
                digitalWalletsDiv.style.display = 'block';
                instapayDiv.style.display = 'none';
            }
        });

        instapayRadio.addEventListener('change', function () {
            if (this.checked) {
                cashDiv.style.display = 'none';
                bankAccountDiv.style.display = 'none';
                digitalWalletsDiv.style.display = 'none';
                instapayDiv.style.display = 'block';
            }
        });

        const Sensitive = document.getElementById('sensitive-yes');
        const InSensitive = document.getElementById('sensitive-no');
        const hiddenInput = document.getElementById('IsSensitive');

        Sensitive.addEventListener('change', updateHiddenInput);
        InSensitive.addEventListener('change', updateHiddenInput);

        function updateHiddenInput() {
            if (Sensitive.checked) {
                hiddenInput.value = 'true';
            } else if (InSensitive.checked) {
                hiddenInput.value = 'false';
            }
        }
    </script>

    <script>
        let currentSlide = 0;
        const slides = document.querySelectorAll('.slide');

        function showSlide(index) {
            if (index < 0) {
                index = slides.length - 1;
            } else if (index >= slides.length) {
                index = 0;
            }
            for (let i = 0; i < slides.length; i++) {
                if (i === index) {
                    slides[i].style.display = 'block';
                } else {
                    slides[i].style.display = 'none';
                }
            }
            currentSlide = index;
        }

        function nextSlide() {
            showSlide(currentSlide + 1);
        }

        function prevSlide() {
            showSlide(currentSlide - 1);
        }

        // Show the first slide initially
        showSlide(0);

    </script>

}

