                            <div class="input-group">
                                <div class="form-check form-check-inline">
                                    <input id="sensitive-yes" class="form-check-input" type="radio" name="gender" value="True">
                                    <label for="sensitive-yes" class="form-check-label fw-bolder text-dark fs-6">نعم</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input id="sensitive-no" class="form-check-input" type="radio" name="gender" value="False">
                                    <label for="sensitive-no" class="form-check-label fw-bolder text-dark fs-6">لا</label>
                                </div>
                            </div>
                            <input asp-for="@Model.IsSensitive" type="hidden" id="IsSensitive">
