<style>
    * {
        direction: rtl !important;
        font-family: "IBM Plex Sans Arabic", sans-serif;
    }

    .num {
        background-color: #E25E3E;
        height: 40px;
        width: 40px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 20px;
        margin-left: 6px;
    }

    .form-control.form-control-solid {
        border-color: #92b0e6;
    }

    .btn {
        background-color: #E25E3E;
    }

        .btn:hover {
            background-color: #FF9B50;
            color: white;
        }

    .select2-container .select2-selection--single {
        height: 40px;
    }
</style>

<div class="row text-center d-flex align-items-center justify-content-center w-100" style="height:800px;">
    <div class="col-6">
        <form asp-controller="Orders" asp-action="Create" enctype="multipart/form-data" class="form w-100" style="margin-top: 59px;" novalidate="novalidate"
>

            <input type="hidden" asp-for="UserId" value="@User.FindFirst(ClaimTypes.NameIdentifier)!.Value" />
            <input type="hidden" asp-for="DeliveryId" />

            <div class="slider-container">
                <div class="slide" id="slide1">
                    <!--begin::Separator-->
                    <div class="d-flex justify-content-start align-items-center mb-7">
                        <span class="fw-bold  fw-bolder text-white num">1</span><h3 class="align-self-end">بياناتك </h3>
                    </div>
                    <!--end::Separator-->
                    <div class="row fv-row text-end">
                        <!--begin::Col-->
                        <div class="col-md-6 mb-7">
                            <label class="form-label fw-bolder text-dark fs-6">الاسم</label>
                            <input asp-for="SenderName" class="form-control form-control-lg form-control-solid" type="text" placeholder="" autocomplete="off" />
                            <span asp-validation-for="SenderName" class="text-danger d-block h-10px"></span>
                        </div>
                        <!--end::Col-->
                        <!--begin::Col-->
                        <div class="col-md-6 mb-7">
                            <label class="form-label fw-bolder text-dark fs-6">رقم هاتف للتواصل </label>
                            <input asp-for="SenderPhoneNumber" class="form-control form-control-lg form-control-solid" type="text" placeholder="" autocomplete="off" />
                            <span asp-validation-for="SenderPhoneNumber" class="text-danger d-block h-10px"></span>
                        </div>
                    </div>
                    <!--begin::Input group-->
                    <div class="row fv-row text-end">
                        <div class="col-md-6 mb-7">
                            <label class="form-label fw-bolder text-dark fs-6">المحافظة</label>
                            <select id="GovernorateId" asp-for="@Model.SenderGovernorateId" asp-items="@Model.Governorates" class="form-select form-select-solid js-select2" data-control="select2" data-placeholder="اختر المحافظة" data-hide-search="true">
                                <option></option>
                            </select>
                            <span asp-validation-for="@Model!.SenderGovernorateId" class="text-danger d-block h-10px"></span>
                        </div>
                        <div class="col-md-6 mb-7">
                            <label class="form-label fw-bolder text-dark fs-6">المدينة</label>
                            <select id="CityId" asp-for="@Model.SenderCityId" asp-items="@Model.Cities" class="form-select form-select-solid js-select2" data-control="select2" data-placeholder="اختر المدينة" data-hide-search="true">
                                <option></option>
                            </select>
                            <span asp-validation-for="@Model!.SenderCityId" class="text-danger d-block h-10px"></span>
                        </div>
                        
                    </div>

                    <div class="modal-footer px-0 py-2 d-flex justify-content-center">
                        <a onclick="nextSlide()" href="#" class="btn " id="nextBtn">التالي</a>
                    </div>
                </div>
                <div class="slide" id="slide2">
                    <!--begin::Separator-->
                    <div class="d-flex justify-content-start align-items-center mb-7">
                        <span class="fw-bold fw-bolder text-white num">2</span><h3 class="align-self-end">بيانات المستلم </h3>
                    </div>
                    <!--end::Separator-->
                    <!--begin::Input group-->
                    <div class="row fv-row text-end w-100">
                        <!--begin::Col-->
                        <div class="col-12 col-md-6 mb-7">
                            <label class="form-label fw-bolder text-dark fs-6">الاسم </label>
                            <input asp-for="RecieverName" class="form-control form-control-lg form-control-solid" type="text" placeholder="" autocomplete="off" />
                            <span asp-validation-for="RecieverName" class="text-danger d-block h-10px"></span>
                        </div>
                        <!--end::Col-->
                        <!--begin::Col-->
                        <div class="col-12 col-md-6 mb-7">
                            <label class="form-label fw-bolder text-dark fs-6">رقم هاتف للتواصل </label>
                            <input asp-for="RecieverPhoneNumber" class="form-control form-control-lg form-control-solid" type="text" placeholder="" autocomplete="off" />
                            <span asp-validation-for="RecieverPhoneNumber" class="text-danger d-block h-10px"></span>
                        </div>
                        <!--end::Col-->
                    </div>
                    
                    <!--begin::Input group-->
                    <div class="row fv-row text-end">
                        <div class="col-md-6 mb-7">
                            <label class="form-label fw-bolder text-dark fs-6">المحافظة</label>
                            <select id="GovernorateId" asp-for="@Model.RecieverGovernorateId" asp-items="@Model.Governorates" class="form-select form-select-solid js-select2" data-control="select2" data-placeholder="اختر المحافظة" data-hide-search="true">
                                <option></option>
                            </select>
                            <span asp-validation-for="@Model!.RecieverGovernorateId" class="text-danger d-block h-10px"></span>
                        </div>
                        <div class="col-md-6 mb-7">
                            <label class="form-label fw-bolder text-dark fs-6">المدينة</label>
                            <select id="CityId" asp-for="@Model.SenderCityId" asp-items="@Model.Cities" class="form-select form-select-solid js-select2" data-control="select2" data-placeholder="اختر المدينة" data-hide-search="true">
                                <option></option>
                            </select>
                            <span asp-validation-for="@Model!.SenderCityId" class="text-danger d-block h-10px"></span>
                        </div>
                    </div>
                    <!--end::Input group-->
                    <!--begin::Input group-->
                    <div class="fv-row mb-7 text-end">
                        <label class="form-label fw-bolder text-dark fs-6">العنوان </label>
                        <input asp-for="RecieverAddress" class="form-control form-control-lg form-control-solid" type="text" placeholder="" autocomplete="off" />
                        <span asp-validation-for="RecieverAddress" class="text-danger d-block h-10px"></span>
                    </div>
                    <!--end::Input group-->
                    <!--begin::Input group-->
                    <div class="fv-row mb-7 text-end">
                        <label class="form-label fw-bolder text-dark fs-6 ">تاريخ الاستلام</label>
                        <div class="input-group">
                            <input asp-for="ShippingDate" class="form-control form-control-solid" placeholder="Pick a date" id="js-Order-flatpicker" />
                        </div>
                        <span asp-validation-for="ShippingDate" class="text-danger d-block h-10px"></span>
                    </div>
                    <!--end::Input group-->
                    <!--begin::Input group-->
                    <div class="fv-row mb-7 text-end">
                        <label class="form-label fw-bolder text-dark fs-6 ">تاريخ التسليم</label>
                        <div class="input-group">
                            <input asp-for="RecieveDate" class="form-control form-control-solid" placeholder="Pick a date" id="js-Order-flatpicker" />
                        </div>
                        <span asp-validation-for="RecieveDate" class="text-danger d-block h-10px"></span>
                    </div>
