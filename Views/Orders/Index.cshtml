@model List<OrderDetailsViewModel>
@{
    Layout = "_DeliveryLayout";
}
<!--begin::Main-->
<div class="app-main flex-column flex-row-fluid " id="kt_app_main">
    <!--begin::Content wrapper-->
    <div class="d-flex flex-column flex-column-fluid">


        <!--begin::Content-->
        <div id="kt_app_content" class="app-content  flex-column-fluid ">
            <!--begin::Content container-->
            <div id="kt_app_content_container" class="app-container  container-fluid ">
                <!--begin::orders-->
                <div class="card ">
                    <!--begin::Header-->
                    <div class="card-header card-header-stretch">
                        <!--begin::Title-->
                        <div class="card-title">
                            <h3>جدول الطلبات</h3>
                        </div>
                        <!--end::Title-->
                        <!--begin::Toolbar-->
                        <div class="card-toolbar">
                            <!--begin::Tab nav-->
                            <ul class="nav nav-stretch fs-5 fw-semibold nav-line-tabs border-transparent" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <a id="kt_referrals_tab_1" class="nav-link text-active-gray-800 me-4 active" data-bs-toggle="tab" role="tab" href="#kt_referrals_1">
                                        طلباتي
                                    </a>
                                </li>                                
                            </ul>
                            <!--end::Tab nav-->
                        </div>
                        <!--end::Toolbar-->
                    </div>
                    <!--end::Header-->
                    <!--begin::Tab content-->
                    <div id="kt_referred_users_tab_content" class="tab-content">
                        <!--begin::Tab panel-->
                        <div id="kt_referrals_1" class="card-body p-0 tab-pane fade show active" role="tabpanel">
                            <div class="table-responsive">
                                <!--begin::Table-->
                                <table class="table table-row-bordered align-middle gy-6">
                                    <!--begin::Thead-->
                                    <thead class="border-bottom border-gray-200 fs-6 fw-bold bg-lighten">
                                        <tr>

                                            <th class="min-w-125px text-center">رقم الطلب</th>
                                            <th class="min-w-115px text-center ps-0">التاريخ</th>
                                            <th class="min-w-125px text-center ps-0">اسم العميل</th>
                                            <th class="min-w-125px text-center">عنوان العميل</th>
                                            <th class="min-w-125px text-center">اسم المستلم</th>
                                            <th class="min-w-125px text-center">عنوان المستلم</th>
                                            <th class="min-w-125px text-center ps-0">السعر</th>
                                        </tr>
                                    </thead>
                                    <!--end::Thead-->
                                    <!--begin::Tbody-->
                                    <tbody class="fs-6 fw-semibold text-gray-600">
                                        @foreach (var order in Model)
                                        {
                                            <tr>
                                                <td class="ps-9 text-center">@order.TrackingNumber</td>
                                                <td class="text-center ps-0">@order.OrderDate</td>
                                                <td class="ps-0 text-center">
                                                    @order.SenderName
                                                </td>
                                                <td class="text-center">@order.SenderAddress</td>
                                                <td class="text-center">@order.RecieverName</td>
                                                <td class="text-center">@order.RecieverAddress</td>
                                                <td class="text-success text-center ps-0">$2,400</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <!--end::Tbody-->
                                </table>
                                <!--end::Table-->
                            </div>
                        </div>
                        <!--end::Tab panel-->
                    </div>
                    <!--end::Tab content-->
                </div>
                <!--end::orders-->
            </div>
            <!--end::Content container-->
        </div>
        <!--end::Content-->

    </div>
    <!--end::Content wrapper-->
</div>
<!--end:::Main-->