@model ResetPasswordFormViewModel
@{
    ViewData["Title"] = $"تغير كلمة السر";
}

<form asp-action="ResetPassword"
      data-ajax-method="post"
      data-ajax="true"
      data-ajax-begin="onModalBegin"
      data-ajax-success="modalSubmitClose"
      data-ajax-failure="showErrorMessage"
      data-ajax-complete="onModalComplete">
    

    <div class="w-100 mb-4">
        <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required">كلمة المرور الحالية</span></label>
        <input type="password" asp-for="OldPassword" class="form-control form-control-solid" placeholder="Enter Password">
        <span asp-validation-for="@Model!.OldPassword" class="text-danger d-block h-10px"></span>
    </div>
    <div class="w-100 mb-4">
        <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required">كلمة المرور الجديدة</span></label>
        <input type="password" asp-for="Password" class="form-control form-control-solid" placeholder="Enter Password">
        <span asp-validation-for="@Model!.Password" class="text-danger d-block h-10px"></span>
    </div>
    <div class="w-100 mb-4">
        <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required">تأكيد كلمة المرور الجديدة</span></label>
        <input type="password" asp-for="ConfirmPassword" class="form-control form-control-solid" placeholder="Confirm Password">
        <span asp-validation-for="@Model!.ConfirmPassword" class="text-danger d-block h-10px"></span>
    </div>
    <div asp-validation-summary="All"></div>
    <partial name="_ModalFooter" />
</form>
