@model DeliveryFormViewModel

<div class="d-flex flex-column gap-7 gap-lg-10" bis_skin_checked="1">
    <!--begin::Inventory-->
    <div class="card card-flush py-4 pb-0" bis_skin_checked="1">
        <!--begin::Card header-->
        <div class="card-header" bis_skin_checked="1">
            <div class="card-title" bis_skin_checked="1">
                <h2>Add Delivery Agent</h2>
            </div>
        </div>
        <!--end::Card header-->
        <!--begin::Card body-->
        <div class="card-body pt-0" bis_skin_checked="1">
            <div class="row">
                <!--begin::Input group-->
                <div class="mb-5 fv-row w-100 w-md-50 fv-plugins-icon-container" bis_skin_checked="1">
                    <!--begin::Label-->
                    <label class="required form-label">First Name</label>
                    <!--end::Label-->
                    <!--begin::Input-->
                    <input type="text" name="sku" class="form-control mb-2" placeholder="Enter First Number" value="">
                    <!--end::Input-->
                    <!--begin::Description-->
                    <div class="text-muted fs-7" bis_skin_checked="1">Enter Your First Name.</div>
                    <!--end::Description-->
                    <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback" asp-validation-for="" bis_skin_checked="1"></div>
                </div>
                <!--end::Input group-->
                <!--begin::Input group-->
                <div class="mb-5 w-100 w-md-50 fv-row fv-plugins-icon-container" bis_skin_checked="1">
                    <!--begin::Label-->
                    <label class="required form-label">Last Name</label>
                    <!--end::Label-->
                    <!--begin::Input-->
                    <input type="text" name="barcode" class="form-control mb-2" placeholder="Last Name" value="">
                    <!--end::Input-->
                    <!--begin::Description-->
                    <div class="text-muted fs-7" bis_skin_checked="1">Enter Your Last Name</div>
                    <!--end::Description-->
                    <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback" bis_skin_checked="1"></div>
                </div>
                <!--end::Input group-->
                <!--begin::Input group-->
                <div class="mb-10 fv-row fv-plugins-icon-container" bis_skin_checked="1">
                    <!--begin::Label-->
                    <label class="required form-label">Quantity</label>
                    <!--end::Label-->
                    <!--begin::Input-->
                    <div class="d-flex gap-3" bis_skin_checked="1">
                        <input type="number" name="shelf" class="form-control mb-2" placeholder="On shelf" value="">
                        <input type="number" name="warehouse" class="form-control mb-2" placeholder="In warehouse">
                    </div>
                    <!--end::Input-->
                    <!--begin::Description-->
                    <div class="text-muted fs-7" bis_skin_checked="1">Enter the product quantity.</div>
                    <!--end::Description-->
                    <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback" bis_skin_checked="1"></div>
                </div>
                <!--end::Input group-->
                <!--begin::Input group-->
                <div class="fv-row" bis_skin_checked="1">
                    <!--begin::Label-->
                    <label class="form-label">Allow Backorders</label>
                    <!--end::Label-->
                    <!--begin::Input-->
                    <div class="form-check form-check-custom form-check-solid mb-2" bis_skin_checked="1">
                        <input class="form-check-input" type="checkbox" value="">
                        <label class="form-check-label">
                            Yes
                        </label>
                    </div>
                    <!--end::Input-->
                    <!--begin::Description-->
                    <div class="text-muted fs-7" bis_skin_checked="1">Allow customers to purchase products that are out of stock.</div>
                    <!--end::Description-->
                </div>
                <!--end::Input group-->
            </div>
           
           
        </div>
        <!--end::Card header-->
    </div>
    <!--end::Inventory-->   
</div>