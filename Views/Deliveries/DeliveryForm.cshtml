@model DeliveryFormViewModel

@{
	Layout = "_LoginLayout";
	ViewData["Title"] = "Sign Up";
}
@section Styles {
     
}

<style>
	.num {
		background-color: cornflowerblue;
		height: 40px;
		width: 40px;
		border-radius: 50%;
		display: flex;
		justify-content: center;
		align-items: center;
		font-size: 20px;
		margin-left: 6px;
	}

	.form-control.form-control-solid {
		border-color: #92b0e6;
	}

</style>

<!--begin::Main-->
<div class="d-flex flex-column flex-root">    
	<!--begin::Authentication - Sign-up -->
	<div class="d-flex flex-column flex-column-fluid bgi-position-y-bottom position-x-center bgi-no-repeat bgi-size-contain bgi-attachment-fixed" style="background-image: url(../../wwwroot/assets/Website/LoginAssets/14-dark.png)">
		<!--begin::Content-->
		<div class="d-flex flex-center flex-column flex-column-fluid p-10 pb-lg-20">
			<!--begin::Logo-->
			<a href="../../demo5/dist/index.html" class="mb-12">
				<img alt="Speedy logo" src="" class="h-40px" />
			</a>
			<!--end::Logo-->
			<!--begin::Wrapper-->
			<div class="w-lg-600px bg-body rounded shadow-sm p-10 p-lg-15 mx-auto">
				<!--begin::Form-->
				<form enctype="multipart/form-data" asp-action="Create" asp-controller="Deliveries" method="post" class="form w-100" novalidate="novalidate" id="kt_sign_up_form">
					<!--begin::Heading-->
					<div class="mb-10 text-center">
						<!--begin::Title-->
						<h1 class="text-dark mb-3">إنشاء حساب جديد</h1>
						<!--end::Title-->
						<!--begin::Link-->
						<div class="text-gray-400 fw-bold fs-4">
							لديك حساب بالفعل؟
							<a href="/Identity/Account/Login" class="link-primary fw-bolder">سجل دخول هنا</a>
						</div>
						<!--end::Link-->
					</div>
					<!--end::Heading-->				
					<div class="card-body pt-6" bis_skin_checked="1">
						<!--begin::Nav-->
						<ul class="nav nav-pills nav-pills-custom mb-3" role="tablist">
							<!--begin::Item-->
							<li class="nav-item mb-3 me-3 me-lg-6" role="presentation">
								<!--begin::Link-->
								<a class="nav-link btn btn-outline btn-flex btn-color-muted btn-active-color-primary flex-column overflow-hidden w-80px h-85px pt-5 pb-2 active"
								   id="kt_stats_widget_16_tab_link_1" data-bs-toggle="pill" href="#kt_stats_widget_16_tab_1"
								   aria-selected="true" role="tab">
								   التالي
								</a>
								<!--end::Link-->
							</li>
							<!--end::Item-->
							<!--begin::Item-->
							<li class="nav-item mb-3 me-3 me-lg-6" role="presentation">
								<!--begin::Link-->
								<a class="nav-link btn btn-outline btn-flex btn-color-muted btn-active-color-primary flex-column overflow-hidden w-80px h-85px pt-5 pb-2"
								   id="kt_stats_widget_16_tab_link_2" data-bs-toggle="pill" href="#Personal_Details"
								   aria-selected="false" role="tab" tabindex="-1">
									التالي
								</a>
								<!--end::Link-->
							</li>
							<!--end::Item-->
							<!--begin::Item-->
							<li class="nav-item mb-3 me-3 me-lg-6" role="presentation">
								<!--begin::Link-->
								<a class="nav-link btn btn-outline btn-flex btn-color-muted btn-active-color-primary flex-column overflow-hidden w-80px h-85px pt-5 pb-2
						" id="kt_stats_widget_16_tab_link_3" data-bs-toggle="pill" href="#vechile_details"
								   aria-selected="false" tabindex="-1" role="tab">
									<!--begin::Icon-->
									<div class="nav-icon mb-3" bis_skin_checked="1">
										<i class="ki-duotone ki-like fs-1"><span class="path1"></span><span class="path2"></span></i>
									</div>
									<!--end::Icon-->
									<!--begin::Title-->
									<span class="nav-text text-gray-800 fw-bold fs-6 lh-1">
										Social
									</span>
									<!--end::Title-->									
								</a>
								<!--end::Link-->
							</li>
							<!--end::Item-->

						</ul>
						<!--end::Nav-->
						<!--begin::Tab Content-->
						<div class="tab-content" bis_skin_checked="1">

							<!--begin::Tap pane-->
							<div class="tab-pane fade active show" id="kt_stats_widget_16_tab_1" bis_skin_checked="1" role="tabpanel">
								<!--begin::Separator-->
								<div class="d-flex justify-content-start align-items-center mb-7">
									<span class="fw-bold  fw-bolder num">1</span><h3 class="align-self-end">بيانات الحساب</h3>
								</div>
								<!--end::Separator-->
								<!--begin::Input group-->
								<div class="row fv-row mb-7">
									<!--begin::Col-->
									<div class="col-md-6">
										<label class="form-label fw-bolder text-dark fs-6">الاسم الأول</label>
										<input asp-for="@Model.FirstName" class="form-control form-control-lg form-control-solid" type="text" placeholder="" name="first-name" autocomplete="off" />
									</div>
									<!--end::Col-->
									<!--begin::Col-->
									<div class="col-md-6">
										<label class="form-label fw-bolder text-dark fs-6">الاسم الأخير</label>
										<input class="form-control form-control-lg form-control-solid" type="text" placeholder="" name="last-name" autocomplete="off" />
									</div>
									<!--end::Col-->
								</div>
								<!--end::Input group-->
								<!--begin::Input group-->
								<div class="fv-row mb-7">
									<label class="form-label fw-bolder text-dark fs-6">البريد الإلكتروني</label>
									<input asp-for="@Model.Email" class="form-control form-control-lg form-control-solid" type="email" placeholder="" name="email" autocomplete="off" />
									<span asp-validation-for="@Model!.Email" class="text-danger d-block h-10px"></span>
								</div>
								<!--end::Input group-->
								<!--begin::Input group-->
								<div class="mb-10 fv-row" data-kt-password-meter="true">
									<!--begin::Wrapper-->
									<div class="mb-1">
										<!--begin::Label-->
										<label class="form-label fw-bolder text-dark fs-6">كلمة المرور</label>
										<!--end::Label-->
										<!--begin::Input wrapper-->
										<div class="position-relative mb-3">
											<input asp-for="@Model.Password" class="form-control form-control-lg form-control-solid" type="password" placeholder="" name="password" autocomplete="off" />
											<span class="btn btn-sm btn-icon position-absolute translate-middle top-50 end-0 me-n2" data-kt-password-meter-control="visibility">
												<i class="bi bi-eye-slash fs-2"></i>
												<i class="bi bi-eye fs-2 d-none"></i>
											</span>
											<span asp-validation-for="@Model!.Password" class="text-danger d-block h-10px"></span>
										</div>
										<!--end::Input wrapper-->
										<!--begin::Meter-->
										<div class="d-flex align-items-center mb-3" data-kt-password-meter-control="highlight">
											<div class="flex-grow-1 bg-secondary bg-active-success rounded h-5px me-2"></div>
											<div class="flex-grow-1 bg-secondary bg-active-success rounded h-5px me-2"></div>
											<div class="flex-grow-1 bg-secondary bg-active-success rounded h-5px me-2"></div>
											<div class="flex-grow-1 bg-secondary bg-active-success rounded h-5px"></div>
										</div>
										<!--end::Meter-->
									</div>
									<!--end::Wrapper-->
									<!--begin::Hint-->
									<div class="text-muted">استخدم 8 أحرف أو أكثر مع مزيج من الحروف والأرقام &amp; الرموز.</div>
									<!--end::Hint-->
								</div>
								<!--end::Input group=-->
								<!--begin::Input group-->
								<div class="fv-row mb-5">
									<label class="form-label fw-bolder text-dark fs-6">تأكيد كلمة المرور</label>
									<input class="form-control form-control-lg form-control-solid" type="password" placeholder="" name="confirm-password" autocomplete="off" />
									<span asp-validation-for="@Model!.ConfirmPassword" class="text-danger d-block h-10px"></span>
								</div>
							</div>
							<!--end::Tap pane-->
							<!--begin::Tap pane-->
							<div class="tab-pane fade active show" id="Personal_Details" bis_skin_checked="1" role="tabpanel">
								<!--begin::Separator-->
								<div class="d-flex justify-content-start align-items-center mb-7">
									<span class="fw-bold  fw-bolder num">2</span><h3 class="align-self-end">بيانات شخصية</h3>
								</div>
								<!--end::Separator-->
								<!--begin::Input group-->
								<div class="fv-row mb-7">
									<label class="form-label fw-bolder text-dark fs-6">الرقم القومي</label>
									<input class="form-control form-control-lg form-control-solid" type="text" placeholder="" name="national-id" autocomplete="off" />
								</div>
								<!--end::Input group-->
								<!--begin::Input group-->
								<div class="fv-row mb-7">
									<label class="form-label fw-bolder text-dark fs-6">رقم الهاتف</label>
									<input asp-for="@Model.MobileNumber" class="form-control form-control-lg form-control-solid" type="text" placeholder="" name="phone-number" autocomplete="off" />
									<span asp-validation-for="@Model!.MobileNumber" class="text-danger d-block h-10px"></span>
								</div>
								<!--end::Input group-->
								<!--begin::Input group-->
								<div class="form-check form-check-custom form-check-solid me-10">
									<input asp-for="@Model.HasWhatsApp" type="checkbox" value="" class="form-check-input h-30px w-30px" id="flexCheckbox30" />
									<label class="form-check-label me-4" for="flexCheckbox30">
										هل هذا الرقم لديه واتساب؟
									</label>
								</div>
								<!--end::Input group-->
								<!--begin::Input group-->
								<div class="fv-row mb-7">
									<label class="form-label fw-bolder text-dark fs-6 mt-3">تاريخ الميلاد</label>
									<input asp-for="@Model.BirthDate" class="form-control form-control-lg form-control-solid" type="date" placeholder="" name="birth-date" autocomplete="off" />
									<span asp-validation-for="@Model!.BirthDate" class="text-danger d-block h-10px"></span>
								</div>
								<!--end::Input group-->
								<!--begin::Input group-->
								<h5 class="fv-row mb-3">النوع</h5>
								<div class="d-flex justify-content-around">
									<div class="form-check form-check-inline">
										<input asp-for="@Model.Gender" class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio1" value="Male">
										<label class="form-check-label fw-bolder text-dark fs-6 " for="inlineRadio1">ذكر</label>
									</div>
									<div class="form-check form-check-inline">
										<input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio2" value="Female">
										<label class="form-check-label fw-bolder text-dark fs-6 " for="inlineRadio2">انثي</label>
									</div>
									<span asp-validation-for="@Model!.Gender" class="text-danger d-block h-10px"></span>
								</div>
								<!--end::Input group-->
								<!--begin::Input group-->
								<div class="fv-row mb-7">
									<label class="form-label fw-bolder text-dark fs-6 mt-5">العنوان</label>
									<input class="form-control form-control-lg form-control-solid" type="text" placeholder="" name="address" autocomplete="off" />
								</div>
								<!--end::Input group-->
								<!--begin::Input group-->
								<div class="row fv-row mb-7 ">
									<div class="col-md-6">
										<label class="form-label fw-bolder text-dark fs-6 mt-5 ">المدينة</label>
										<input class="form-control form-control-lg form-control-solid w-" type="text" placeholder="" name="city" autocomplete="off" />
									</div>
									<!--end::Input group-->
									<!--begin::Input group-->
									<div class="col-md-6">
										<label class="form-label fw-bolder text-dark fs-6 mt-5">المحافظة</label>
										<input class="form-control form-control-lg form-control-solid w-45" type="text" placeholder="" name="Governorate" autocomplete="off" />
									</div>
								</div>
							</div>
							<!--end::Tap pane-->
							<!--begin::Tap pane-->
							<div class="tab-pane fade active show" id="vechile_details" bis_skin_checked="1" role="tabpanel">
								<!--begin::Separator-->
								<div class="d-flex justify-content-start align-items-center mb-7">
									<span class="fw-bold  fw-bolder num">3</span><h3 class="align-self-end">تفاصيل وسيلة التوصيل</h3>
								</div>
								<!--end::Separator-->
								<!--begin::Input group-->
								<h5 class="fv-row mb-7 ">هل سبق لك و عملت فى مجال التوصيل؟</h5>
								<div class="d-flex justify-content-around">
									<div class="form-check form-check-inline mb-7">
										<input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio1" value="نعم">
										<label class="form-check-label fw-bolder text-dark fs-6 " for="inlineRadio1">نعم</label>
									</div>
									<div class="form-check form-check-inline mb-7">
										<input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio2" value="لا">
										<label class="form-check-label fw-bolder text-dark fs-6 " for="inlineRadio2">لا</label>
									</div>
								</div>
								<!--end::Input group-->
								<!--begin::Input group-->
								<div class="fv-row mb-7">
									<label class="form-label fw-bolder text-dark fs-6">نوع وسيلة التوصيل التي تملكها</label>
									<input class="form-control form-control-lg form-control-solid" type="text" placeholder="" name="نوع وسيلة المواصلات" autocomplete="off" />
								</div>
								<!--end::Input group-->
								<!--begin::Input group-->
								<div class="fv-row mb-7">
									<label class="form-label fw-bolder text-dark fs-6">فى حالة وجود سيارة او دراجه ناريه (موتوسيكل) أرفق صورة الرخصة الخاصه بها</label>
									<input class="form-control form-control-lg form-control-solid" type="file" accept=".png, .jpg, .jpeg" placeholder="" name="صورة الرخصه" autocomplete="off" />
								</div>
								<!--end::Input group-->
								<!--begin::Input group-->
								<div class="fv-row mb-7">
									<label class="form-label fw-bolder text-dark fs-6">أرفق صورة البطاقة الشخصية (يجب أن تكون ساريه)</label>
									<input class="form-control form-control-lg form-control-solid" type="file" accept=".png, .jpg, .jpeg" placeholder="" name="صورة البطاقة" autocomplete="off" />
								</div>
								<!--end::Input group-->
								<!--begin::Input group-->
								<div class="fv-row mb-7">
									<label class="form-label fw-bolder text-dark fs-6 lh-lg">أرفق صورة من الفيش الجنائي الخاص بك<br>(يجب أن يكون تاريخ صدوره من ثلاث أشهر كحد أقصى) </label>
									<input class="form-control form-control-lg form-control-solid" type="file" placeholder="" name="الفيش" autocomplete="off" />
								</div>
								<!--end::Input group-->
								<!--begin::Input group-->
								<div class="fv-row mb-10">
									<label class="form-check form-check-custom form-check-solid form-check-inline">
										<input class="form-check-input" type="checkbox" name="toc" value="1" required />
										<span class="form-check-label fw-bold text-gray-700 fs-6 me-3">
											أقر بأني موافق على كل
											<a href="#" class="ms-1 link-primary">الشروط و الأحكام</a>.
										</span>
									</label>
								</div>
								<!--end::Input group-->
								<!--begin::Actions-->
								<div class="text-center">
									<button type="button" id="kt_sign_up_submit" class="btn btn-lg btn-primary">
										<span class="indicator-label">تسجيل</span>
										<span class="indicator-progress">
											برجاء الانتظار
											<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
										</span>
									</button>
								</div>
								<!--end::Actions-->
							</div>
							<!--end::Tap pane-->
							<!--end::Table container-->
						</div>
						<!--end::Tab Content-->
					</div>


					

					@* <!--begin::Image input-->
					<div style="" class="image-input image-input-empty" data-kt-image-input="true">
						<!--begin::Image preview wrapper-->
						<div class="image-input-wrapper w-125px h-125px"></div>
						<!--end::Image preview wrapper-->
						<!--begin::Edit button-->
						<label class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-white shadow"
							   data-kt-image-input-action="change"
							   data-bs-toggle="tooltip"
							   data-bs-dismiss="click"
							   title="Change avatar">
							<i class="bi bi-pencil-fill fs-7"></i>

							<!--begin::Inputs-->
							<input type="file" name="avatar" accept=".png, .jpg, .jpeg" />
							<input type="hidden" name="avatar_remove" />
							<!--end::Inputs-->
						</label>
						<!--end::Edit button-->
						<!--begin::Cancel button-->
						<span class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-white shadow"
							  data-kt-image-input-action="cancel"
							  data-bs-toggle="tooltip"
							  data-bs-dismiss="click"
							  title="Cancel avatar">
							<i class="bi bi-x fs-2"></i>
						</span>
						<!--end::Cancel button-->
						<!--begin::Remove button-->
						<span class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-white shadow"
							  data-kt-image-input-action="remove"
							  data-bs-toggle="tooltip"
							  data-bs-dismiss="click"
							  title="Remove avatar">
							<i class="bi bi-x fs-2"></i>
						</span>
						<!--end::Remove button-->
					</div>
					<h5 class="fv-row mb-7 mt-3">قم باختيار صورة شخصية لحسابك</h5> *@

					<!--end::Image input-->
					

					
				</form>
				<!--end::Form-->
			</div>
			<!--end::Wrapper-->
		</div>
		<!--end::Content-->
		<!--begin::Footer-->
		<div class="d-flex flex-center flex-column-auto p-10">
			<!--begin::Links-->
			<div class="d-flex align-items-center fw-bold fs-6">
				<a href="https://keenthemes.com" class="text-muted text-hover-primary px-2">About</a>
				<a href="mailto:support@keenthemes.com" class="text-muted text-hover-primary px-2">Contact</a>
				<a href="https://1.envato.market/EA4JP" class="text-muted text-hover-primary px-2">Contact Us</a>
			</div>
			<!--end::Links-->
		</div>
		<!--end::Footer-->
	</div>
	<!--end::Authentication - Sign-up-->
</div>


@section Scripts
{
	<partial name="_ValidationScriptsPartial" />
    
}  