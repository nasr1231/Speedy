@model DeliveryViewModel

<td>@($"{@Model.FirstName} {@Model.LastName}")</td>
<td>@Model.NID</td>
<td>@Model.Email</td>
<td>@Model.CreatedOn</td>
<td>
    <span class="badge badge-light-@(Model.IsDeleted ? "danger" : "success")">
        @(Model.IsDeleted ? "Not Active" : "Available")
    </span>
</td>
<td class="text-center">
    <a href="javascript:;" class="px-3 js-toggle-status menu-link"
       data-id="@Model.Id" data-url="/Deliveries/Block/@Model.Id" data-title="Edit User">
        Block
    </a>
</td>  