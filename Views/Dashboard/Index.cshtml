@model AdminDashboardViewModel
@{
    ViewData["Title"] = "الصفحة الرئيسية";
    Layout = "~/Views/shared/_Layout.cshtml";
}

<div class="card shadow-sm mb-5 mb-lg-10 p-6" style="min-height: 547px;">
    <div class="row d-flex flex-row align-items-center justify-content-center h-50 w-100">
        <div class="col-3">
            <div class="card card-flush h-md-50" bis_skin_checked="1">
                <!--begin::Header-->
                <div class="card-header pt-5" bis_skin_checked="1">
                    <!--begin::Title-->
                    <div class="card-title d-flex flex-column" bis_skin_checked="1">
                        <!--begin::Info-->
                        <div class="d-flex align-items-center" bis_skin_checked="1">
                            <!--begin::Amount-->
                            <span class="fs-2hx fw-bold text-gray-900 me-2 lh-1 ls-n2">0</span>
                            <!--end::Amount-->
                        </div>
                        <!--end::Info-->
                        <!--begin::Subtitle-->
                        <span class="text-gray-500 pt-1 fw-semibold fs-6">Total Orders</span>
                        <!--end::Subtitle-->
                    </div>
                    <!--end::Title-->
                </div>
                <!--end::Header-->
                <!--begin::Card body-->
                <div class="card-body d-flex align-items-end pt-0" bis_skin_checked="1">
                    <!--begin::Progress-->
                    <div class="d-flex align-items-center flex-column mt-3 w-100" bis_skin_checked="1">
                        <div class="d-flex justify-content-between w-100 mt-auto mb-2" bis_skin_checked="1">
                            <span class="fw-bolder fs-6 text-gray-900">1,048 to Goal</span>
                            <span class="fw-bold fs-6 text-gray-500">62%</span>
                        </div>

                        <div class="h-8px mx-3 w-100 bg-light-success rounded" bis_skin_checked="1">
                            <div class="bg-success rounded h-8px" role="progressbar" style="width: 62%;" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100" bis_skin_checked="1"></div>
                        </div>
                    </div>
                    <!--end::Progress-->
                </div>
                <!--end::Card body-->
            </div>
        </div>   
        <div class="col-3">
            <div class="card card-flush h-md-50" bis_skin_checked="1">
                <!--begin::Header-->
                <div class="card-header pt-5" bis_skin_checked="1">
                    <!--begin::Title-->
                    <div class="card-title d-flex flex-column" bis_skin_checked="1">
                        <!--begin::Info-->
                        <div class="d-flex align-items-center" bis_skin_checked="1">
                            <!--begin::Currency-->
                            <span class="fs-4 fw-semibold text-gray-500 me-1 align-self-start"></span>
                            <!--end::Currency-->
                            <!--begin::Amount-->
                            <span class="fs-2hx fw-bold text-gray-900 me-2 lh-1 ls-n2">@Model.Deliveries.Count()</span>
                            <!--end::Amount-->                            
                        </div>
                        <!--end::Info-->
                        <!--begin::Subtitle-->
                        <span class="text-gray-500 pt-1 fw-semibold fs-6">Number Of Delivery</span>
                        <!--end::Subtitle-->
                    </div>
                    <!--end::Title-->
                </div>
                <!--end::Header-->
                <!--begin::Card body-->
                <div class="card-body pt-2 pb-4 d-flex align-items-center w-100" bis_skin_checked="1">
                    <!--begin::Labels-->
                    <div class="d-flex flex-column content-justify-center w-100" bis_skin_checked="1">
                        <!--begin::Label-->
                        <div class="d-flex fs-6 fw-semibold align-items-center" bis_skin_checked="1">
                            <!--begin::Bullet-->
                            <div class="bullet w-8px h-6px rounded-2 bg-danger me-3" bis_skin_checked="1"></div>
                            <!--end::Bullet-->
                            <!--begin::Label-->
                            <div class="text-gray-500 flex-grow-1 me-4" bis_skin_checked="1">Avaliable</div>
                            <!--end::Label-->
                            <!--begin::Stats-->
                            <div class="fw-bolder text-gray-700 text-xxl-end" bis_skin_checked="1"> @Model.Deliveries.Where(x => !x.IsDeleted).Count()</div>
                            <!--end::Stats-->
                        </div>
                        <!--end::Label-->
                        <!--begin::Label-->
                        <div class="d-flex fs-6 fw-semibold align-items-center my-3" bis_skin_checked="1">
                            <!--begin::Bullet-->
                            <div class="bullet w-8px h-6px rounded-2 bg-primary me-3" bis_skin_checked="1"></div>
                            <!--end::Bullet-->
                            <!--begin::Label-->
                            <div class="text-gray-500 flex-grow-1 me-4" bis_skin_checked="1">Not Avaliable</div>
                            <!--end::Label-->
                            <!--begin::Stats-->
                            <div class="fw-bolder text-gray-700 text-xxl-end" bis_skin_checked="1"> @Model.Deliveries.Where(x => x.IsDeleted).Count()</div>
                            <!--end::Stats-->
                        </div>
                        <!--end::Label-->
                        <!--begin::Label-->
                        <div class="d-flex fs-6 fw-semibold align-items-center" bis_skin_checked="1">
                            <!--begin::Bullet-->
                            <div class="bullet w-8px h-6px rounded-2 me-3" style="background-color: #E4E6EF" bis_skin_checked="1"></div>
                            <!--end::Bullet-->
                            <!--begin::Label-->
                            <div class="text-gray-500 flex-grow-1 me-4" bis_skin_checked="1">Blocked</div>
                            <!--end::Label-->
                            <!--begin::Stats-->
                            <div class=" fw-bolder text-gray-700 text-xxl-end" bis_skin_checked="1"> @Model.Deliveries.Where(x => x.AppUser.IsActive == false).Count()</div>
                            <!--end::Stats-->
                        </div>
                        <!--end::Label-->
                    </div>
                    <!--end::Labels-->
                </div>
                <!--end::Card body-->
            </div>
        </div>   
        <div class="col-3">
            <div class="card card-flush" bis_skin_checked="1">
                <!--begin::Header-->
                <div class="card-header pt-5" bis_skin_checked="1">
                    <!--begin::Title-->
                    <div class="card-title d-flex flex-column" bis_skin_checked="1">
                        <!--begin::Info-->
                        <div class="d-flex align-items-center" bis_skin_checked="1">
                            <!--begin::Currency-->
                            <span class="fs-4 fw-semibold text-gray-500 me-1 align-self-start"></span>
                            <!--end::Currency-->
                            <!--begin::Amount-->
                            <span class="fs-2hx fw-bold text-gray-900 me-2 lh-1 ls-n2">@Model.TotalStartUps</span>
                            <!--end::Amount-->

                        </div>
                        <!--end::Info-->
                        <!--begin::Subtitle-->
                        <span class="text-gray-500 pt-1 fw-semibold fs-6">Number Of Start Ups</span>
                        <!--end::Subtitle-->
                    </div>
                    <!--end::Title-->
                </div>
                <!--end::Header-->
                <!--begin::Card body-->
                <div class="card-body d-flex align-items-end px-0 pb-0" bis_skin_checked="1">
