@model EditStartUpFormViewModel


<form asp-action="Edit" asp-controller="StartUps"
      data-ajax-method="post"
      data-ajax="true"
      data-ajax-begin="onModalBegin"
      data-ajax-success="modalSubmitSuccess "
      data-ajax-failure="showErrorMessage"
      data-ajax-complete="onModalComplete">

    <input type="hidden" asp-for="Id" />

    <div class="row mb-5">
        <div class="w-100 w-md-50">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required"></span>الأسم</label>
            <input type="text" asp-for="FirstName" class="form-control form-control-solid" placeholder="">
            <span asp-validation-for="@Model!.FirstName" class="text-danger d-block h-10px"></span>
        </div>
        <div class="w-100 w-md-50">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required">رقم الهاتف</span></label>
            <input type="text" asp-for="LastName" class="form-control form-control-solid" placeholder="رقم هاتفك">
            <span asp-validation-for="@Model!.LastName" class="text-danger d-block h-10px"></span>
        </div>
        <div class="w-100">
            <label class="d-flex align-items-center fs-6 fw-bold mb-2"><span class="required">رقم الهاتف</span></label>
            <input type="text" asp-for="PhoneNumber" class="form-control form-control-solid" placeholder="رقم هاتفك">
            <span asp-validation-for="@Model!.PhoneNumber" class="text-danger d-block h-10px"></span>
        </div>
    </div>

    <partial name="_ModalFooter" />
</form>
