@model StartUpViewModel

<td>@($"{@Model.FirstName} {@Model.LastName}")</td>
<td>@Model.StartUpName</td>
<td>@Model.Email</td>
<td>@Model.CreatedOn</td>
<td>
    <span class="js-status badge badge-light-@(Model.IsActive ? "success" : "danger")">
        @(Model.IsActive ? "Active" : "Not Active")
    </span>
</td>
<td class="text-center">
    <a href="javascript:;" class="btn btn-info py-2 px-4 js-toggle-status"
       data-id="@Model.Id" data-url="/StartUps/Block/@Model.Id" data-title="Change Status" data-message="Do You Want To Change The Status?!">
        Change Status
    </a>
</td>  