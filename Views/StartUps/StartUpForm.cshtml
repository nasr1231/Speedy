@model StartUpFormViewModel

@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Sign Up - StartUp";
}


<style>
    .num {
        background-color: #E25E3E;
        height: 40px;
        width: 40px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 20px;
        margin-left: 6px;
    }

    div a, span a {
        color: #E25E3E;
    }

    .end .btn {
        background-color: #E25E3E;
        color: white;
    }

    .form-control.form-control-solid {
        border-color: #92b0e6;
    }

    .nextmain {
        position: fixed;
        top: 48%;
        right: 11%;
        color: #a3a1a1;
    }

        .nextmain:hover {
            cursor: pointer;
            color: #888686;
        }

    .next {
        display: block;
        font-size: 26px;
        font-weight: 600;
        margin-right: 16px;
        color: #00000096;
    }

    .prevmain {
        position: fixed;
        top: 48%;
        left: 11%;
        color: #a3a1a1;
    }

        .prevmain:hover {
            cursor: pointer;
            color: #888686;
        }

    .prev {
        display: block;
        font-size: 26px;
        font-weight: 600;
        color: #00000096
    }

</style>

<!--begin::Main-->
<div class="d-flex flex-column flex-root">
    <!--begin::Authentication - Sign-up -->
    <div class="d-flex flex-column flex-column-fluid bgi-position-y-bottom position-x-center bgi-no-repeat bgi-size-contain bgi-attachment-fixed" style="background-image: url(/assets/Website/LoginAssets/bg14.png)">
        <!--begin::Content-->
        <div class="d-flex flex-center flex-column flex-column-fluid p-10 pb-lg-20">
            <!--begin::Logo-->
            
            <!--end::Logo-->
            <!--begin::Wrapper-->
            <div class="w-lg-600px bg-body rounded shadow-sm p-10 p-lg-15 mx-auto" style="padding-top: 30px !important">
                <!--begin::Form-->
                <form enctype="multipart/form-data" asp-action="Create" asp-controller="StartUps" method="post" class="form w-100" novalidate="novalidate">
                    <!--begin::Heading-->
                    <div class="mb-5 text-center">
                        <!--begin::Title-->
                        <h1 class="text-dark mb-3">إنشاء حساب جديد</h1>
                        <!--end::Title-->
                        <!--begin::Link-->
                        <div class="text-gray-400 fw-bold fs-4">
                            لديك حساب بالفعل؟
                            <a href="/Identity/Account/Login" class=" fw-bolder">سجل دخول هنا</a>
                        </div>
                        <!--end::Link-->
                    </div>
                    <!--end::Heading-->
                    <div class="card-body" bis_skin_checked="1">
                        <div class="slider-container">
                            <div class="slide" id="slide1">
                                <!--begin::Separator-->
                                <div class="d-flex justify-content-start align-items-center mb-7">
                                    <span class="fw-bold  fw-bolder text-white num">1</span><h3 class="align-self-end">بيانات الحساب</h3>
                                </div>
                                <!--end::Separator-->
                                <!--begin::Input group-->
                                <div class="row fv-row ">
                                    <!--begin::Col-->
                                    <div class="col-md-6 mb-7">
                                        <label asp-for="FirstName" class="form-label fw-bolder text-dark fs-6"></label>
                                        <input asp-for="FirstName" class="form-control form-control-lg form-control-solid" type="text" placeholder="" autocomplete="off" />
                                        <span asp-validation-for="FirstName" class="text-danger d-block h-10px"></span>
                                    </div>
                                    <!--end::Col-->
                                    <!--begin::Col-->
                                    <div class="col-md-6 mb-7">
                                        <label asp-for="LastName" class="form-label fw-bolder text-dark fs-6"></label>
                                        <input asp-for="LastName" class="form-control form-control-lg form-control-solid" type="text" placeholder="" autocomplete="off" />
                                        <span asp-validation-for="LastName" class="text-danger d-block h-10px"></span>
                                    </div>
                                    <!--end::Col-->
                                </div>
                                <!--end::Input group-->
                                <!--begin::Input group-->
                                <div class="fv-row mb-7">
                                    <label class="form-label fw-bolder text-dark fs-6">البريد الإلكتروني</label>
                                    <input asp-for="Email" class="form-control form-control-lg form-control-solid" type="email" placeholder="" autocomplete="off" />
                                    <span asp-validation-for="Email" class="text-danger d-block h-10px"></span>
                                </div>
                                <!--end::Input group-->
                                <!--begin::Input group-->
                                <div class="mb-10 fv-row" data-kt-password-meter="true">
                                    <!--begin::Wrapper-->
                                    <div class="mb-1">
                                        <!--begin::Label-->
                                        <label class="form-label fw-bolder text-dark fs-6">كلمة المرور</label>
                                        <!--end::Label-->
                                        <!--begin::Input wrapper-->
                                        <div class="position-relative mb-3">
                                            <input asp-for="@Model.Password" class="form-control form-control-lg form-control-solid" type="password" placeholder="" autocomplete="off" />
                                            <span class="btn btn-sm btn-icon position-absolute translate-middle top-50 start-0 me-n2 mt-1" style="left: 4% !important;top: 40% !important" data-kt-password-meter-control="visibility">
                                                <i class="bi bi-eye-slash fs-2"></i>
                                                <i class="bi bi-eye fs-2 d-none"></i>
                                            </span>
                                        </div>
                                        <!--end::Input wrapper-->
                                        <!--begin::Meter-->
                                        <div class="d-flex align-items-center mb-3" data-kt-password-meter-control="highlight">
                                            <div class="flex-grow-1 bg-secondary bg-active-success rounded h-5px me-2"></div>
                                            <div class="flex-grow-1 bg-secondary bg-active-success rounded h-5px me-2"></div>
                                            <div class="flex-grow-1 bg-secondary bg-active-success rounded h-5px me-2"></div>
                                            <div class="flex-grow-1 bg-secondary bg-active-success rounded h-5px"></div>
                                        </div>
                                        <!--end::Meter-->
                                    </div>
                                    <!--end::Wrapper-->
                                    <!--begin::Hint-->
                                    <div class="text-muted">استخدم 8 أحرف أو أكثر مع مزيج من الحروف والأرقام &amp; الرموز.</div>
                                    <!--end::Hint-->
                                    <span asp-validation-for="@Model!.Password" class="text-danger d-block h-10px"></span>
                                </div>
                                <!--end::Input group=-->
                                <!--begin::Input group-->
                                <div class="mb-10 fv-row" data-kt-password-meter="true">
                                    <!--begin::Wrapper-->
                                    <div class="mb-1">
                                        <!--begin::Label-->
                                        <label class="form-label fw-bolder text-dark fs-6">تأكيد كلمة المرور</label>
                                        <!--end::Label-->
                                        <!--begin::Input wrapper-->
                                        <div class="position-relative mb-3">
                                            <input asp-for="@Model.ConfirmPassword" class="form-control form-control-lg form-control-solid" type="password" placeholder="" autocomplete="off" />
                                            <span class="btn btn-sm btn-icon position-absolute translate-middle top-50 start-0 me-n2" style="left: 4% !important;top: 40% !important" data-kt-password-meter-control="visibility">
                                                <i class="bi bi-eye-slash fs-2"></i>
                                                <i class="bi bi-eye fs-2 d-none"></i>
                                            </span>
                                            <span asp-validation-for="@Model!.ConfirmPassword" class="text-danger d-block h-10px"></span>
                                        </div>
                                        <!--end::Input wrapper-->
                                    </div>
                                    <!--end::Wrapper-->
                                </div>
                                <!--end::Input group=-->
                                <a onclick="nextSlide()" class="nextmain">
                                    <i class=" fa-regular fa-circle-right fa-6x"></i>
                                    <span class="next">
                                        التالي
                                    </span>

                                </a>
                            </div>
                            <div class="slide" id="slide3">
                                <!--begin::Separator-->
                                <div class="d-flex justify-content-start align-items-center mb-7">
                                    <span class="fw-bold  fw-bolder text-white num">2</span><h3 class="align-self-end">بيانات الشركة</h3>
                                </div>
                                <!--end::Separator-->
                                <!--begin::Input group-->
                                <div class="fv-row mb-7">
                                    <label class="form-label fw-bolder text-dark fs-6">اسم الشركة </label>
                                    <input asp-for="@Model.StartUpName" class="form-control form-control-lg form-control-solid" type="text" placeholder="" autocomplete="off" />
                                    <span asp-validation-for="@Model!.StartUpName" class="text-danger d-block h-10px"></span>
                                </div>
                                <!--end::Input group-->
                                <div class="mb-5">
                                    <h5 class="fv-row mb-3 form-label fw-bolder text-dark fs-6 ">الصورة الشخصية</h5>
                                    <div style="background-image: url(/assets/Portrait_Placeholder.png)" class="image-input image-input-empty" data-kt-image-input="true">
                                        <!--begin::Image preview wrapper-->
                                        <div class="image-input-wrapper w-200px h-200px"></div>
                                        <!--end::Image preview wrapper-->
                                        <!--begin::Edit button-->
                                        <label class="btn btn-icon btn-circle btn-active-color-primary w-25px h-20px bg-white shadow"
                                               data-kt-image-input-action="change"
                                               data-bs-toggle="tooltip"
                                               data-bs-dismiss="click"
                                               title="تغيير الصورة">
                                            <i class="bi bi-pencil-fill fs-7"></i>

                                            <!--begin::Inputs-->
                                            <input type="file" asp-for="UserImage" accept=".png, .jpg, .jpeg" />
                                            <!--end::Inputs-->
                                        </label>
                                        <!--end::Edit button-->
                                        <!--begin::Cancel button-->
                                        <span class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-white shadow"
                                              data-kt-image-input-action="cancel"
                                              data-bs-toggle="tooltip"
                                              data-bs-dismiss="click"
                                              title="إلغاء الصورة">
                                            <i class="bi bi-x fs-2"></i>
                                        </span>
                                        <!--end::Cancel button-->
                                        <!--begin::Remove button-->
                                        <span class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-white shadow"
                                              data-kt-image-input-action="remove"
                                              data-bs-toggle="tooltip"
                                              data-bs-dismiss="click"
                                              title="Remove avatar">
                                            <i class="bi bi-x fs-2"></i>
                                        </span>
                                        <!--end::Remove button-->
                                    </div>
                                    <span asp-validation-for="UserImage" class="text-danger d-block"></span>
                                </div>
                                <!--begin::Input group-->
                                <div class="fv-row mb-9">
                                    <label class="form-label fw-bolder text-dark fs-6 ">تاريخ إنشاء الشركة</label>
                                    <div class="input-group">
                                        <input asp-for="@Model.EstablishDate" type="date" style="border-radius:8px; ;border-top-left-radius:0 ;
                                         border-bottom-left-radius: 0;" class="form-control form-control-lg form-control-solid birthdate-flatpickr" placeholder="Username" aria-label="Username" aria-describedby="basic-addon1" />
                                        <span style="border-radius:8px;border-top-right-radius:0 ;
                                          border-bottom-right-radius: 0;" class="input-group-text" id="basic-addon1">
                                            <i class="fa-solid fa-calendar-days fs-4"></i>
                                        </span>
                                    </div>
                                    <span asp-validation-for="@Model!.EstablishDate" class="text-danger d-block h-10px"></span>
                                </div>
                                <!--end::Input group-->
                                @* <!--begin::Input group-->
                                <h5 class="fv-row form-label fw-bolder text-dark fs-6  ">هل الشركة افتراضية (online)</h5>
                                <div class="d-flex justify-content-around mb-7">
                                <div class="form-check form-check-inline">
                                <input asp-for="@Model.IsOnline" class="form-check-input" type="radio" value="1" checked="@Model.IsOnline">
                                <label class="form-check-label fw-bolder text-dark fs-6">نعم</label>
                                </div>
                                <div class="form-check form-check-inline">
                                <input asp-for="@Model.IsOnline" class="form-check-input" type="radio" checked="@(!Model.IsOnline)">
                                <label class="form-check-label fw-bolder text-dark fs-6">لا</label>
                                </div>
                                </div> *@

                                <!--end::Input group-->
                                <!--begin::Input group-->
                                <div class="fv-row mb-7">
                                    <label class="form-label fw-bolder text-dark fs-6">العنوان</label>
                                    <input asp-for="@Model.Address" class="form-control form-control-lg form-control-solid" type="text" placeholder="" autocomplete="off" />
                                    <span asp-validation-for="@Model!.Address" class="text-danger d-block h-10px"></span>
                                </div>
                                <!--end::Input group-->
                                <!--begin::Input group-->
                                <div class="row fv-row ">
                                    <div class="col-md-6 mb-7">
                                        <label class="form-label fw-bolder text-dark fs-6">المحافظة</label>
                                        <select id="GovernorateId" asp-for="@Model.SelectedGovernorateId" asp-items="@Model.Governorates" class="form-select form-select-solid js-select2" data-control="select2" data-placeholder="اختر المحافظة" data-hide-search="true">
                                            <option></option>
                                        </select>
                                        <span asp-validation-for="@Model!.SelectedGovernorateId" class="text-danger d-block h-10px"></span>
                                    </div>
                                    <div class="col-md-6 mb-7">
                                        <label class="form-label fw-bolder text-dark fs-6">المدينة</label>
                                        <select id="CityId" asp-for="@Model.SelectedCityId" asp-items="@Model.Cities" class="form-select form-select-solid js-select2" data-control="select2" data-placeholder="اختر المدينة" data-hide-search="true">
                                            <option></option>
                                        </select>
                                        <span asp-validation-for="@Model!.SelectedCityId" class="text-danger d-block h-10px"></span>
                                    </div>
                                    <!--begin::Input group-->
                                    <div class="fv-row mb-7">
                                        <label class="form-label fw-bolder text-dark fs-6">رابط الموقع الرسمي  </label>
                                        <input @*asp-for="Urls"*@ class="form-control form-control-lg form-control-solid" type="text" placeholder="" autocomplete="off" />
                                    </div>
                                    <!--end::Input group-->
                                    <!--begin::Input group-->
                                    <div class="fv-row mb-7">
                                        <label class="form-label fw-bolder text-dark fs-6 ">رابط الفيسبوك  </label>
                                        <div class="input-group">
                                            <input type="text" asp-for="@Model.Urls" style="border-radius:8px; border-top-left-radius:0;border-bottom-left-radius: 0;" class="form-control form-control-lg form-control-solid" aria-label="Username" aria-describedby="basic-addon1" />
                                            <span style="border-radius:8px; border-top-right-radius:0 ;
                                            border-bottom-right-radius: 0;" class="input-group-text" id="basic-addon1">
                                                <i class="fa-brands fa-facebook-f fs-4"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <!--begin::Input group-->
                                    <!--begin::Input group-->
                                    <div class="fv-row mb-7">
                                        <label class="form-label fw-bolder text-dark fs-6 ">رابط الانستجرام  </label>
                                        <div class="input-group">
                                            <input @* asp-for="@Model.Urls" *@ type="text" style="border-radius:8px; border-top-left-radius:0; border-bottom-left-radius: 0;" class="form-control form-control-lg form-control-solid" aria-label="Username" aria-describedby="basic-addon1" />
                                            <span style="border-radius:8px;border-top-right-radius:0;border-bottom-right-radius: 0; " class="input-group-text" id="basic-addon1">
                                                <i class="fa-brands fa-instagram fs-4"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <!--end::Input group-->
                                    <!--begin::Input group-->
                                    <div class="fv-row mb-7">
                                        <label class="form-label fw-bolder text-dark fs-6">رقم الهاتف</label>
                                        <input asp-for="@Model.MobileNumber" class="form-control form-control-lg form-control-solid" type="text" placeholder="" autocomplete="off" />
                                        <span asp-validation-for="@Model!.MobileNumber" class="text-danger d-block h-10px"></span>
                                    </div>
                                    <!--end::Input group-->
                                    <!--begin::Input group-->
                                    <div class="form-check form-check-custom form-check-solid me-10 mb-7">
                                        <input asp-for="@Model.HasWhatsApp" type="checkbox" class="form-check-input h-30px w-30px" />
                                        <label class="form-check-label me-4">
                                            هل هذا الرقم لديه واتساب؟
                                        </label>
                                    </div>
                                    <!--end::Input group-->

                                </div>
                                <!--end::Input group-->
                                <!--begin::Input group-->
                                <div class="fv-row mb-10">
                                    <label class="form-check form-check-custom form-check-solid form-check-inline">
                                        <input class="form-check-input" type="checkbox" id="AcceptTerms" />
                                        <span class="form-check-label fw-bold text-gray-700 fs-6 me-3">
                                            أقر بأني موافق على كل
                                            <a href="~/Home/Terms" class="ms-1" target="_blank">الشروط و الأحكام</a>.
                                        </span>
                                    </label>
                                </div>
                                <div asp-validation-summary="All" class="text-danger"></div>
                                <!--end::Input group-->
                                <div class="end text-center">
                                    <button type="submit" class="btn btn-lg " id="Submit-Btn">
                                        <span class="indicator-label">تسجيل</span>
                                        <span class="indicator-progress">
                                            برجاء الانتظار
                                            <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                                        </span>
                                    </button>
                                </div>
                                <!--end::Input group-->
                                <a onclick="prevSlide()" class="prevmain">
                                    <i class=" fa-regular fa-circle-left fa-6x"></i>
                                    <span class="prev">
                                        السابق
                                    </span>

                                </a>
                            </div>
                        </div>
                    </div>
                </form>
                <!--end::Form-->
            </div>
            <!--end::Wrapper-->
        </div>
        <!--end::Content-->
        <!--begin::Footer-->
        
        <!--end::Footer-->
    </div>
    <!--end::Authentication - Sign-up-->
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@section Plugins {
    <script src="~/js/slider.js" asp-append-version="true"></script>
    <script src="~/js/IntitateCities.js" asp-append-version="true"></script>
    <script src="~/js/register.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $(".birthdate-flatpickr").flatpickr(
                {
                    "autoApply": true,
                    "showDropdowns": true,
                    "drops": 'up',
                    "disable": [
                        function (date) {
                            let currentDate = new Date();
                            // return true to disable
                            return (date >= currentDate)
                        }
                    ],
                }
            )
        });
    </script>
}