@model StartUpProfileViewModel

@{
    Layout = "_StartLayout";
    ViewData["Title"] = "حسابي";
}

@section Styles {

    <link href="~/assets/Panel/plugins/datatables/datatables.bundle.css" rel="stylesheet" crossorigin="anonymous" />
}

<div class="container d-flex flex-column flex-column-fluid border border-gray-300 rounded-4" style="margin-top:100px;margin-bottom:100px;">
    <!--begin::Toolbar-->
    <div id="kt_app_toolbar" class="app-toolbar pt-5">
        <!--begin::Toolbar container-->
        <div id="kt_app_toolbar_container" class="app-container  container-fluid d-flex align-items-stretch ">
            <!--begin::Toolbar wrapper-->
            <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
                <!--begin::Page title-->
                <div class="page-title d-flex flex-column gapr-1 me-3 mb-2">
                    <!--begin::Title-->
                    <h1 class="page-heading d-flex flex-column justify-content-center text-gray-900 fw-bolder fs-1 lh-0 p-4">
                        نظرة عامة على حسابك
                    </h1>
                    <!--end::Title-->
                </div>
                <!--end::Page title-->

            </div>
            <!--end::Toolbar wrapper-->
        </div>
        <!--end::Toolbar container-->
    </div>
    <!--end::Toolbar-->
    <!--begin::Content-->
    <div id="kt_app_content" class="app-content flex-column-fluid ">
        <!--begin::Content container-->
        <div id="kt_app_content_container" class="app-container container-fluid ">
            <!--begin::Navbar-->
            <div class="card mb-5 mb-xl-10 mt-5">
                <div class="card-body pt-3 pb-0">

                    <!--begin::Details-->
                    <div class="d-flex flex-wrap flex-sm-nowrap mb-0">
                        <div class="me-7 mb-4" bis_skin_checked="1">
                            <div class="symbol symbol-100px symbol-lg-160px symbol-fixed position-relative" bis_skin_checked="1">
                                <img src="@Model.ProfilePicture" alt="image" class="h-100">
                                <div class="position-absolute translate-middle bottom-0 start-100 mb-6 bg-success rounded-circle border border-4 border-body h-20px w-20px" bis_skin_checked="1"></div>
                            </div>
                        </div>
                        <!--begin::Info-->
                        <div class="flex-grow-1">
                            <!--begin::Title-->
                            <div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
                                <!--begin::User-->
                                <div class="d-flex flex-column">
                                    <!--begin::Name-->
                                    <div class="d-flex align-items-center mb-7">
                                        <a class="text-gray-900 text-primary fs-2 fw-bold me-5">@Model.CompanyName</a>
                                    </div>
                                    <!--end::Name-->
                                    <!--begin::Info-->
                                    <div class="d-flex flex-wrap fw-semibold fs-6 mb-4 pe-2">
                                        <a href="#" class="d-flex align-items-center text-gray-500 text-hover-primary me-5 mb-2">
                                            <i class="fa-solid fa-user fs-4 me-1 ms-2">
                                                <span class="path1"></span>
                                                <span class="path2"></span>
                                                <span class="path3"></span>
                                            </i>        شركة
                                        </a>
                                        <a href="#" class="d-flex align-items-center text-gray-500 text-hover-primary me-5 mb-2">
                                            <i class="fa-solid fa-location-dot fs-4 me-1 ms-2"><span class="path1"></span><span class="path2"></span></i>
                                            @Model.City
                                        </a>
                                        <a href="#" class="d-flex align-items-center text-gray-500 text-hover-primary mb-2 me-4">
                                            <i class="fa-solid fa-caret-down fs-4 me-1 ms-2"><span class="path1"></span><span class="path2"></span></i>
                                            @Model.Email
                                        </a>
                                    </div>
                                    <!--end::Info-->
                                </div>
                                <!--end::User-->

                            </div>
                            <!--end::Title-->
                            <!--begin::Stats-->
                            <div class="d-flex flex-wrap flex-stack">
                                <!--begin::Wrapper-->
                                <div class="d-flex flex-column flex-grow-1 pe-8">
                                    <!--begin::Stats-->
                                    <div class="d-flex flex-wrap">
                                        <!--begin::Stat-->
                                        <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                            <!--begin::Number-->
                                            <div class="d-flex align-items-center">
                                                <i class="fa-solid fa-arrow-trend-up text-success fs-2 me-2"><span class="path1"></span><span class="path2"></span></i>
                                                <div class="fs-2 fw-bold" data-kt-countup="true" data-kt-countup-value="0" data-kt-countup-prefix="">0</div>
                                            </div>
                                            <!--end::Number-->
                                            <!--begin::Label-->
                                            <div class="fw-semibold fs-6 text-gray-500">الأرباح</div>
                                            <!--end::Label-->
                                        </div>
                                        <!--end::Stat-->
                                        <!--begin::Stat-->
                                        <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                            <!--begin::Number-->
                                            <div class="d-flex align-items-center">
                                                <i class="fa-solid fa-star fs-2 me-2 text-warning"><span class="path1"></span><span class="path2"></span></i>
                                                <div class="fs-2 fw-bold" data-kt-countup="true" data-kt-countup-value="" data-kt-countup-prefix="%">0</div>
                                            </div>
                                            <!--end::Number-->
                                            <!--begin::Label-->
                                            <div class="fw-semibold fs-6 text-gray-500">التقييم </div>
                                            <!--end::Label-->
                                        </div>
                                        <!--end::Stat-->
                                    </div>
                                    <!--end::Stats-->
                                </div>
                                <!--end::Wrapper-->
                                <ul class="nav nav-stretch nav-line-tabs nav-line-tabs-2x border-transparent fs-5 fw-bold w-100">
                                    <!--begin::Nav item-->
                                    <li class="nav-item mt-2" role="presentation">
                                        <a class="nav-link text-active-primary ms-0 me-10 py-5 active"
                                           data-bs-toggle="tab"
                                           href="#Personal_Details" role="tab">
                                            بياناتك الشخصية
                                        </a>
                                    </li>
                                    <!--end::Nav item-->
                                    <!--begin::Nav item-->
                                    <li class="nav-item mt-2" role="presentation">
                                        <a class="nav-link text-active-primary ms-0 me-10 py-5"
                                           data-bs-toggle="tab" role="tab"
                                           href="#Settings">
                                            الإعدادات
                                        </a>
                                    </li>
                                    <!--end::Nav item-->
                                    <!--begin::Nav item-->
                                    <li class="nav-item mt-2" role="presentation">
                                        <a class="nav-link text-active-primary ms-0 me-10 py-5 "
                                           data-bs-toggle="tab" role="tab"
                                           href="#demo1">
                                            طلباتي
                                        </a>
                                    </li>
                                    <!--end::Nav item-->
                                </ul>
                            </div>
                            <!--end::Stats-->
                        </div>
                        <!--end::Info-->
                    </div>
                    <!--end::Details-->
                </div>
            </div>
            <div class="tab-content" id="myTabContent">
                <div class="tab-pane fade active show" id="Personal_Details" role="tabpanel">
                    <div class="card mb-5 mb-xl-10" id="kt_profile_details_view">
                        <!--begin::Card header-->
                        <div class="card-header cursor-pointer">
                            <!--begin::Card title-->
                            <div class="card-title m-0">
                                <h3 class="fw-bold m-0"> تفاصيل الحساب</h3>
                            </div>
                            <!--end::Card title-->
                            <a data-url="/StartUps/Edit/@User.FindFirst(ClaimTypes.NameIdentifier)!.Value" href="javascript:;" data-title="تعديل بيانات الحساب" class="btn btn-sm btn-primary align-self-center js-render-modal"> تعديل الحساب</a>
                        </div>
                        <!--begin::Card header-->
                        <!--begin::Card body-->
                        <div class="card-body p-9">
                            <!--begin::Row-->
                            <div class="row mb-7">
                                <!--begin::Label-->
                                <label class="col-lg-4 fw-bolder text-muted">الاسم بالكامل </label>
                                <!--end::Label-->
                                <!--begin::Col-->
                                <div class="col-lg-8">
                                    <span class="fw-bold fs-6 text-gray-800">
                                        @Model.FirstName @Model.LastName
                                    </span>
                                </div>
                                <!--end::Col-->
                            </div>
                            <!--end::Row-->
                            <!--begin::Input group-->
                            <div class="row mb-7">
                                <!--begin::Label-->
                                <label class="col-lg-4 fw-bolder text-muted">رقم الهاتف </label>
                                <!--end::Label-->
                                <!--begin::Col-->
                                <div class="col-lg-8 fv-row">
                                    <span class="fw-semibold text-gray-800 fs-6">@Model.PhoneNumber</span>
                                </div>
                                <!--end::Col-->
                            </div>
                            <!--end::Input group-->
                            <!--begin::Input group-->
                            <div class="row mb-7">
                                <!--begin::Label-->
                                <label class="col-lg-4 fw-bolder text-muted">
                                    حالة الحساب
                                </label>
                                <!--end::Label-->
                                <!--begin::Col-->
                                <div class="col-lg-8 d-flex align-items-center">
                                    <span class="fw-bold fs-6 text-gray-800 me-2"></span>
                                    <span class="badge badge-@(Model.IsDeleted ? "danger" : "success")">
                                        تم التحقق
                                    </span>
                                </div>
                                <!--end::Col-->
                            </div>
                            <!--end::Input group-->
                            <!--begin::Input group-->
                            <div class="row mb-7">
                                <!--begin::Label-->
                                <label class="col-lg-4 fw-bolder text-muted">   البريد الالكتروني الخاص بالشركة</label>
                                <!--end::Label-->
                                <!--begin::Col-->
                                <div class="col-lg-8">
                                    <a href="#" class="fw-semibold fs-6 text-gray-800 text-hover-primary">
                                        startup@gmail.com
                                    </a>
                                </div>
                                <!--end::Col-->
                            </div>
                            <!--end::Input group-->
                            <!--begin::Input group-->
                            <div class="row mb-7">
                                <!--begin::Label-->
                                <label class="col-lg-4 fw-bolder text-muted">   رقم الهاتف الخاص بالشركة</label>
                                <!--end::Label-->
                                <!--begin::Col-->
                                <div class="col-lg-8">
                                    <a href="#" class="fw-semibold fs-6 text-gray-800 text-hover-primary">
                                        01537458926
                                    </a>
                                </div>
                                <!--end::Col-->
                            </div>
                            <!--end::Input group-->
                            <!--begin::Input group-->
                            <div class="row mb-7">
                                <!--begin::Label-->
                                <label class="col-lg-4 fw-bolder text-muted">
                                    العنوان بالكامل
                                    <span class="ms-1" data-bs-toggle="tooltip" title="Country of origination">
                                        <i class="ki-duotone ki-information fs-7"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i>
                                    </span>
                                </label>
                                <!--end::Label-->
                                <!--begin::Col-->
                                <div class="col-lg-8">
                                    <span class="fw-bold fs-6 text-gray-800">@Model.Address</span>
                                </div>
                                <!--end::Col-->
                            </div>
                            <!--end::Input group-->

                        </div>
                        <!--end::Card body-->
                    </div>
                </div>
            </div>
            <div class="tab-content" id="myTabContent">
                <div class="tab-pane fade" id="Settings" role="tabpanel">
                    <div class="card  mb-5 mb-xl-10">
                        <!--begin::Card header-->
                        <div class="card-header border-0 cursor-pointer" role="button" data-bs-toggle="collapse"
                             data-bs-target="#kt_account_signin_method">
                            <div class="card-title m-0">
                                <h3 class="fw-bold m-0">بيانات حسابك</h3>
                            </div>
                        </div>
                        <!--end::Card header-->
                        <!--begin::Content-->
                        <div id="kt_account_settings_signin_method" class="collapse show">
                            <!--begin::Card body-->
                            <div class="card-body border-top p-9">
                                <!--begin::Email Address-->
                                <div class="d-flex flex-wrap  align-items-center">
                                    <!--begin::Label-->
                                    <div id="kt_signin_email">
                                        <div class="fs-6 fw-bold mb-1">الإيميل</div>
                                        <div class="fw-semibold text-gray-600">
                                            @Model.Email
                                        </div>
                                    </div>
                                    <!--end::Label-->
                                    <!--begin::Action-->
                                    <div id="kt_signin_email_button" class="ms-auto">
                                        <button class="btn btn-light btn-active-light-primary me-12">تغيير الإيميل</button>
                                    </div>
                                    <!--end::Action-->
                                </div>
                                <!--end::Email Address-->
                                <!--begin::Separator-->
                                <div class="separator separator-dashed my-6"></div>
                                <!--end::Separator-->
                                <!--begin::Password-->
                                <div class="d-flex flex-wrap align-items-center mb-10">
                                    <!--begin::Label-->
                                    <div>
                                        <div class="fs-6 fw-bold mb-1">كلمة السر</div>
                                        <div class="fw-semibold text-gray-600">************</div>
                                    </div>
                                    <!--end::Label-->
                                    <!--begin::Action-->

                                    <div class="ms-auto me-12">
                                        <a href="javascript:;" class="btn btn-light btn-active-light-primary js-render-modal" data-url="/Deliveries/ResetPassword/@User.FindFirst(ClaimTypes.NameIdentifier)!.Value" data-title="تغير كلمة السر">تغيير كلمة السر</a>
                                    </div>


                                    <!--end::Action-->
                                </div>
                                <!--end::Password-->
                            </div>
                            <!--end::Card body-->
                        </div>
                        <!--end::Content-->
                    </div>
                </div>
            </div>
            <div class="tab-content" id="myTabContent">
                <div class="tab-pane fade" id="demo1" role="tabpanel">
                    <div class="card mb-5 mb-xl-10">
                        @if (Model.Orders.Any())
                        {
                            @foreach (var order in Model.Orders)
                            {
                                <div class="col-4">
                                    <div class="card-body py-9" bis_skin_checked="1">
                                        <!--begin::Row-->
                                        <div class="row gx-9 h-100" bis_skin_checked="1">
                                            <!--begin::Col-->
                                            <div class="col-sm-6 mb-10 mb-sm-0" bis_skin_checked="1">
                                                <!--begin::Image-->
                                                <div class="bgi-no-repeat bgi-position-center bgi-size-cover card-rounded min-h-400px min-h-sm-100 h-100" style="background-size: 100% 100%;background-image:url('@order.OrderAttachment')" bis_skin_checked="1">
                                                </div>
                                                <!--end::Image-->
                                            </div>
                                            <!--end::Col-->
                                            <!--begin::Col-->
                                            <div class="col-sm-6" bis_skin_checked="1">
                                                <!--begin::Wrapper-->
                                                <div class="d-flex flex-column h-100" bis_skin_checked="1">
                                                    <!--begin::Header-->
                                                    <div class="mb-7" bis_skin_checked="1">
                                                        <!--begin::Headin-->
                                                        <div class="d-flex flex-stack mb-6" bis_skin_checked="1">
                                                            <!--begin::Title-->
                                                            <div class="flex-shrink-0 me-5" bis_skin_checked="1">
                                                                <span class="text-gray-800 fs-1 fw-bold">@Model.DeliveryUser.FirstName @Model.DeliveryUser.FirstName</span>
                                                            </div>
                                                            <!--end::Title-->
                                                            <span class="badge badge-light-primary flex-shrink-0 align-self-center py-3 px-4 fs-7">@order.OrderStatus</span>
                                                        </div>
                                                        <!--end::Heading-->
                                                    </div>
                                                    <!--end::Header-->
                                                    <!--begin::Body-->
                                                    <div class="mb-6" bis_skin_checked="1">
                                                        <!--begin::Text-->
                                                        <span class="fw-semibold text-gray-600 fs-6 mb-8 d-block">
                                                            @order.Description
                                                        </span>
                                                        <!--end::Text-->
                                                        <!--begin::Stats-->
                                                        <div class="d-flex" bis_skin_checked="1">
                                                            <!--begin::Stat-->
                                                            <div class="border border-gray-300 border-dashed rounded min-w-100px w-100 py-2 px-4 me-6 mb-3 col-6" bis_skin_checked="1">
                                                                <!--begin::Date-->
                                                                <span class="fs-6 text-gray-700 fw-bold">@order.RecieveDate</span>
                                                                <!--end::Date-->
                                                                <!--begin::Label-->
                                                                <div class="fw-semibold text-gray-500" bis_skin_checked="1">
                                                                    Due Date
                                                                </div>
                                                                <!--end::Label-->
                                                            </div>
                                                            <!--end::Stat-->
                                                            <!--begin::Stat-->
                                                            <div class="border border-gray-300 border-dashed rounded min-w-100px w-100 py-2 px-4 mb-3" bis_skin_checked="1">
                                                                <!--begin::Number-->
                                                                <span class="fs-6 text-gray-700 fw-bold"><span class="ms-n1 counted" data-kt-countup="true" data-kt-countup-value="@(@order.Fees + @order.OrderTotal)" data-kt-initialized="1">@(@order.Fees + @order.OrderTotal) جنيه</span></span>
                                                                <!--end::Number-->
                                                                <!--begin::Label-->
                                                                <div class="fw-semibold text-gray-500" bis_skin_checked="1">Cost</div>
                                                                <!--end::Label-->
                                                            </div>
                                                            <!--end::Stat-->
                                                        </div>
                                                        <!--end::Stats-->
                                                    </div>
                                                    <!--end::Body-->
                                                </div>
                                                <!--end::Wrapper-->
                                            </div>
                                            <!--end::Col-->
                                        </div>
                                        <!--end::Row-->
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12 d-flex justify-content-center">
                                <span class="text-danger fs-5">
                                    لا يوجد طلبات الأن
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <!--end::Toolbar container-->
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
