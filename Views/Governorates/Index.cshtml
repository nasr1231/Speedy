@model IEnumerable<GovernorateViewModel>

@{
    ViewData["Title"] = "المحافظات";
}

@section Styles
{    
    <link href="~/assets/panel/plugins/datatables/datatables.bundle.css" rel="stylesheet" />
}


<div class="card shadow-sm mb-5 mb-lg-10">
    <div class="card-header">
        <div class="card-title">
            <div class="symbol symbol-70px me-4">
                <div class="symbol-label fs-2 fw-semibold text-success">
                    <!--begin::Svg Icon | path: icons/duotune/general/gen014.svg-->
                    <span class="svg-icon svg-icon-fluid svg-icon-primary">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path opacity="0.3" d="M21.25 18.525L13.05 21.825C12.35 22.125 11.65 22.125 10.95 21.825L2.75 18.525C1.75 18.125 1.75 16.725 2.75 16.325L4.04999 15.825L10.25 18.325C10.85 18.525 11.45 18.625 12.05 18.625C12.65 18.625 13.25 18.525 13.85 18.325L20.05 15.825L21.35 16.325C22.35 16.725 22.35 18.125 21.25 18.525ZM13.05 16.425L21.25 13.125C22.25 12.725 22.25 11.325 21.25 10.925L13.05 7.62502C12.35 7.32502 11.65 7.32502 10.95 7.62502L2.75 10.925C1.75 11.325 1.75 12.725 2.75 13.125L10.95 16.425C11.65 16.725 12.45 16.725 13.05 16.425Z" fill="currentColor" />
                            <path d="M11.05 11.025L2.84998 7.725C1.84998 7.325 1.84998 5.925 2.84998 5.525L11.05 2.225C11.75 1.925 12.45 1.925 13.15 2.225L21.35 5.525C22.35 5.925 22.35 7.325 21.35 7.725L13.05 11.025C12.45 11.325 11.65 11.325 11.05 11.025Z" fill="currentColor" />
                        </svg>
                    </span>
                    <!--end::Svg Icon-->
                </div>
                <span class="symbol-badge badge badge-circle bg-primary start-100 text-white">@Model.Count()</span>
            </div>
            <h2>Governorates</h2>
        </div>
        <div class="card-toolbar my-7">
            <a href="/RelatedData" class="btn btn-md btn-success me-2">
                Back To Settings
            </a>
            <a href="javascript:;" class="btn btn-primary js-render-modal" data-title="Add Governorate" data-url="/Governorates/Create">
                <i class="bi bi-plus-circle"></i>
                Add
            </a>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-5 mb-lg-10">
    <div class="card-header">
        <partial name="_TableHeader" />
    </div>

    <div class="card-body pt-0">
        <div class="table-responsive">
            <table class="table table-row-bordered table-row-gray-300 gy-3 align-middle js-datatable" data-export-title="قائمة المحافظات">
                <thead>
                    <tr class="fw-bold fs-6 text-gray-800 text-center">
                        <th class="text-center">Name</th>
                        <th class="text-center">Logs</th>
                        <th class="js-no-export text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var Governorates in Model)
                    {
                        <tr>
                            <partial name="_RowData" model="Governorates" />
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Plugins {
    <script src="~/assets/Panel/plugins/datatables/datatables.bundle.js"></script>
    <script src="~/assets/Panel/plugins/datatables/vfs_fonts.js" asp-append-version="true"></script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
