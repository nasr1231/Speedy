@model CitiesHomeViewModel

@{
    ViewData["Title"] = "الصفحة الرئيسية";
    Layout = "_StartLayout";
}

<style>
    .select2-container .select2-selection--single {
        display: flex;
        height: 45px; 
    }
</style>

<div class="container d-flex align-items-center justify-content-center" style="height: 600px;">
    <div class="row d-flex align-items-center justify-content-center">
        <div class="col-8">
            <form asp-controller="Orders" asp-action="Filter" method="get">
                <select asp-for="CityId" asp-items="@Model.Cities" style="border-radius:8px; border-top-left-radius:0;border-bottom-left-radius: 0;" class="form-control form-control-lg form-control-solid border-gray-400" data-control="select2" data-placeholder="اختار مكان اقامتك" data-allow-clear="true">
                    <option></option>
                </select>
                <span asp-validation-for="Cities"></span>
                <button type="submit" class="btn btn-primary">
                    <span class="indicator-label">
                        Save
                    </span>
                </button>

                
            </form>
        </div>
    </div>
</div>


<div class="main d-flex flex-column align-items-center flex-column-fluid justify-content-center">
    <h1 class="mb-4">إبدأ تجربة توصيل سريعة معنا الآن</h1>
    <div class=" d-flex w-100 mb-4 justify-content-center ">
        <div class=" d-flex flex-column flex-md-row justify-content-center align-items-center">
            <div class="fv-row">
                <div class="input-group input-group-solid flex-nowrap">
                    <div class="overflow-hidden flex-grow-1">
                        <select class="form-select form-select-solid rounded-start-0 border-start" data-control="select2" data-placeholder="Select an option">
                            <option></option>
                            <option value="1">Option 1</option>
                            <option value="2">Option 2</option>
                            <option value="3">Option 3</option>
                            <option value="4">Option 4</option>
                            <option value="5">Option 5</option>
                        </select>
                    <span class="input-group-text">
                        <i class="ki-duotone ki-notepad-bookmark fs-3"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span><span class="path6"></span></i>
                    </span>
                    </div>
                </div>

            </div>
            <button class="btn m-5" style="border-radius:8px;">أدخل موقعك وتابع</button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />   
}
