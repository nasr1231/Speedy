@model CitiesHomeViewModel

@{
    ViewData["Title"] = "الصفحة الرئيسية";
    Layout = "_StartLayout";
}

<style>
    .main {
        padding-top: 200px;
        margin-right: 0;
    }

    .input-group {
        flex-wrap: nowrap;
    }

    .selection {
        display: flex;
    }

    .select2-container .select2-selection--single {
        display: flex;
        height: 45px;
        border-radius: 8px;
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
        flex: 1 1 auto;
        width: 1%;
        min-width: 0;
    }

    .input-group select {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
        border-top-right-radius: 8px !important;
        border-bottom-right-radius: 8px !important;
    }
</style>


<div class="main d-flex flex-column align-items-center justify-content-center flex-column-fluid bgi-position-y-bottom position-x-center bgi-no-repeat bgi-size-contain" style="background-image: url(/assets/Website/LoginAssets/bg14.png); padding-bottom:130px;">
    <h1 class="mb-7">إبدأ تجربة توصيل سريعة معنا الآن</h1>
    <div class=" d-flex w-100 mb-4 justify-content-center">
        <div class=" d-flex flex-column flex-md-row justify-content-center align-items-center">
            <form asp-controller="Orders" asp-action="Filter" method="post" class="d-flex  flex-column justify-content-center align-items-center">
                <div class="fv-row row">
                    <div class="input-group col-md-6 mb-7">
                        <select asp-for="CityId" asp-items="@Model.Cities" class="form-control form-control-lg form-control-solid border-gray-400" data-control="select2" data-placeholder=" اختر مكان اقامتك " data-allow-clear="true">
                            <option></option>
                        </select>
                        <span style="border-radius:8px; border-top-right-radius:0; border-bottom-right-radius: 0;" class="input-group-text border-gray-400" id="basic-addon1">
                            <i class="fa-solid fa-location-dot fs-4"></i>
                        </span>
                        <span asp-validation-for="Cities"></span>

                    </div>
                </div>
                <button type="submit" class="btn m-5" style="border-radius:8px; background-color:#E25E3E;">اختر وتابع</button>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
