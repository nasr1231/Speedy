@{
    ViewData["Title"] = "الصفحة الرئيسية";
    Layout = "_StartLayout";
}
<div class="container h-600px d-flex flex-column flex-column-fluid bgi-position-y-bottom position-x-center bgi-no-repeat bgi-size-contain " style="background-image: url(/assets/Website/LoginAssets/bg14.png);">
    <form asp-action="Complain" class="mx-auto  d-flex flex-column align-items-center" style="margin-top:150px;">

        <h2 class="d-flex w-55 justify-content-center align-items-center">
            <h2 class="d-block my-6">
                هل تريد أن تنضم إلينا كعامل توصيل!
            </h2>
            
            <br/>
            <h3 class="d-block mb-6">
                للإنضمام سجل بياناتك معنا الآن

            </h3>
            
        </h2>

        <button type="submit" class="btn w-15 " style="background-color:#E25E3E;">
            سجل الآن!
        </button>


    </form>
</div>