@{
    ViewData["Title"] = "الصفحة الرئيسية";
    Layout = "_StartLayout";
}
<div class="container h-700px d-flex flex-column flex-column-fluid bgi-position-y-bottom position-x-center bgi-no-repeat bgi-size-contain " style="background-image: url(/assets/Website/LoginAssets/bg14.png);">
    <div class="main d-flex h-700 flex-column align-items-center justify-content-center flex-column-fluid bgi-position-y-bottom position-x-center bgi-no-repeat bgi-size-contain" style="background-image: url(/assets/Website/LoginAssets/bg14.png); padding-bottom:130px;">
        <div class=" d-flex w-100 mb-4 justify-content-center">
            <div class=" d-flex flex-column flex-md-row justify-content-center align-items-center">
                <a asp-controller="Deliveries" asp-action="Dashboard" asp-route-id="@User.FindFirst(ClaimTypes.NameIdentifier)!.Value" class=" fs-2 btn mt-15" style="background-color:#E25E3E;">
                    الوصول إلى لوحة التحكم
                </a>
            </div>
        </div>
    </div>
</div>