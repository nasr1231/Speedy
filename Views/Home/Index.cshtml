@{
    ViewData["Title"] = "الصفحة الرئيسية";
    Layout = "_StartLayout";
}

@section Styles{

}
<div class="main-banner wow fadeIn" id="top" data-wow-duration="1s" data-wow-delay="0.5s">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="row">
                    <div class="col-lg-6 align-self-center">
                        <div class="left-content show-up header-text wow fadeInLeft" data-wow-duration="1s" data-wow-delay="1s">
                            <div class="row">
                                <div class="col-lg-12">
                                    <h2>انضم إلينا الآن فى موقعنا المميز Speedy</h2>
                                    <p>يوفر سبيدي تجربة حقيقية لتوصيل أي شيء من أي مكان، وهو أمر ممكن فقط من خلال منصتنا المميزة بكثير من عمال التوصيل المسجلين عند الطلب .</p>
                                </div>
                                <div class="col-lg-12">
                                    <div class="white-button first-button scroll-to-section">
                                        <a id="modal_trigger" asp-action="Register">
                                            <i class="fa fa-sign-in-alt"></i>
                                            سجل الآن
                                        </a>
                                    </div>
                                </div>
  

                            </div>
                        </div>

                    </div>
                    <div class="col-lg-6">
                        <div class="right-image wow fadeInRight" data-wow-duration="1s" data-wow-delay="0.5s">
                            <img src="assets/images/slider-dec.png" alt="">
                        </div>
                        <div class="delivery right-image ">
                            <img src="assets/website/images/delivery.png" />"
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="services" class="services section">
    <div class="container">
        <div class="row justify-content-end">
            <div class="col-lg-8 offset-lg-2">
                <div class="section-heading ">
                    <h4> <em> خدمات &amp; ميزات </em> مذهلة بالنسبة لكل مستخدم</h4>
                    <img class="img-fluid" src="assets/images/heading-line-dec.png" alt="">
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="service-item first-service">
                    <div class="icon"></div>
                    <h4>عامل توصيل</h4>
                    <p>.إذا كنت تملك وسيلة توصيل (عجلة - سيارة - موتوسيكل) و تبحث عن المنصة المناسبه للعمل الحر أو تريد أن تحسن دخلك يمكنك أن تعمل معنا بمجرد تسجيل بعض البيانات </p>
                    <div class="text-button">
                        <a href="#">الشروط و الأحكام<i class="fa fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-lg-3">
                <div class="service-item second-service">
                    <div class="icon"></div>
                    <h4>عميل</h4>
                    <p>.إذا كنت تبحث عن وسيلة سريعة و آمنه لتوصيل هدية أو أي شيء آخر من مكانك إلى أحد أصدقائك , أقاربك أو غيرهم فى أى وقت من اليوم , عليك التسجيل معنا و الإستمتاع بهذة الخدمة</p>
                    <div class="text-button">
                        <a href="#">Read More <i class="fa fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-lg-3">
                <div class="service-item third-service">
                    <div class="icon"></div>
                    <h4>شركة ناشئة</h4>
                    <p>إذا كانت شركتك ناشئة و تريد أن تتوسع و تنتشر سريعا و توصل منتجاتك إلى عملائك بشكل آمن , سرع , و بتكلفة مناسبة.  <br>سجل معنا الآن و استمتع بهذه الخدمة و أنتظر عروضنا المخصصة لك</p>
                    <div class="text-button">
                        <a href="#">Read More <i class="fa fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-lg-3">
                <div class="service-item fourth-service">
                    <div class="icon"></div>
                    <h4>شركة كبرى</h4>
                    <p>إذا كانت شركتك تعاني من كثرة الطلبات و عدم القدرة على توصيلها جميعها فى الوقت المطلوب. <br /> .يمكننا مساعدتك فى هذا بمجرد مليء بعض البيانات و اختيار عمال التوصيل الذين ترغب بهم لتوصيل طلباتك فى وقت قياسي</p>
                    <div class="text-button">
                        <a href="#">Read More <i class="fa fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="about" class="about-us section">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 align-self-center">
                <div class="section-heading">
                    <h4>أهم ما يتميز به <em> Speedy</em>   </h4>
                     

                    <p class="text-center mt-4">يحرص Speedy على التعامل مع كل طلبية بعناية فائقة لضمان رضاكم وثقتكم بخدماتنا.</p>
                </div>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="box-item">
                            <h4><a href="#">توفير خدمات التوصيل على مدار الساعة</a></h4>
                            <p class="mt-3">ضمان تلبية احتياجاتكم في أي وقت من اليوم.</p>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="box-item">
                            <h4><a href="#">أسعار تنافسية في المتناول </a></h4>
                            <p class="mt-3">مما يتيح لكم الاستفادة من خدمات عالية الجودة دون أن تؤثر على ميزانيتكم.</p>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="box-item">
                            <h4><a href="#">دعمًا فنيًا وخدمة عملاء على مدار الساعة</a></h4>
                            <p class="mt-3">
                                لحل أي مشكلة تواجه المستخدمين فى أى وقت من اليوم.

                            </p>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="box-item">
                            <h4><a href="#"> خدمة توصيل سريعة </a></h4>
                            <p class="mt-3">بحيث تصل طلباتكم في الوقت المحدد دون أي تأخير مما يتيح الحصول على الأشياء الضرورية في وقت قصير .</p>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <p class="text-center">
                            تتيح للمستخدمين توصيل مجموعة واسعة من المنتجات، بما في ذلك الملابس، الإلكترونيات، الأدوية، الهدايا، والمستلزمات المنزلية.
                        </p>
                        <div class="gradient-button">
                            <a href="#">Start 14-Day Free Trial</a>
                        </div>
                        <span>*No Credit Card Required</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="right-image">
                    <img src="~/assets/website/images/delivery-bro (1).png" />

                </div>
            </div>
        </div>
    </div>
</div>

