@model CityFormViewModel


<form asp-action="@(Model?.Id > 0 ? "Edit" : "Create")"
      data-ajax-method="post"
      data-ajax="true"
      data-ajax-begin="onModalBegin"
      data-ajax-success="modalSubmitSuccess"
      data-ajax-failure="showErrorMessage"
      data-ajax-complete="onModalComplete">

    <div class="mb-2">
        @if (Model?.Id > 0)
        {
            <input type="hidden" asp-for="Id" />

        }
        <!--begin::Input group-->
        <div class="form-floating mb-2">
            <input type="text" asp-for="Name" class="form-control" placeholder="اسم المدينة" />
            <label asp-for="Name">City</label>
        </div>
        <!--end::Input group-->
        <span asp-validation-for="Name" class="text-danger d-block"></span>

    </div>
    <div class="mb-2">
        <label class="form-label fw-bolder text-dark fs-6">المدينة</label>
        <select asp-for="GovernorateId" asp-items="@Model.Governorate" class="form-select form-select-solid js-select2" data-control="select2" data-placeholder="اختر المحافظة" data-hide-search="true">
            <option></option>
        </select>
    </div>
   
    <partial name="_ModalFooter" />
</form>

